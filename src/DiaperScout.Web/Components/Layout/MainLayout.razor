@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="ds-app-shell">
    <header class="ds-app-header">
        <div class="ds-header-inner">
            <a class="ds-brand" href="/" aria-label="DiaperScout home">
                <img src="/images/brand/DiaperScout.svg"
                     alt="DiaperScout"
                     class="ds-brand-logo" />
            </a>

            <NavMenu />

            <div class="ds-header-actions">
                <AuthorizeView>
                    <Authorized>
                        <span class="ds-header-user">@context.User.Identity?.Name</span>
                        <a class="ds-header-signin" href="/signout">
                            Sign out
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="ds-header-signin" href="/signin">
                            Sign in
                        </a>

                        <a class="ds-header-join" href="/join">
                            Join DiaperScout
                            <span aria-hidden="true">★</span>
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <main class="ds-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <span>An unexpected error occurred.</span>
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">×</button>
</div>
