@inherits LayoutComponentBase

<div class="ds-app-shell">
    <header class="ds-app-header">
        <a class="ds-brand" href="/" aria-label="DiaperScout home">
            <span class="ds-brand-mark" aria-hidden="true">🧭</span>
            <span class="ds-brand-name">DiaperScout</span>
        </a>

        <NavMenu />
    </header>

    <main class="ds-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <span>An unexpected error occurred.</span>
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">×</button>
</div>