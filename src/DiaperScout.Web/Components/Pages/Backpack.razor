@page "/backpack"
<PageTitle>Backpack · DiaperScout</PageTitle>
<section class="backpack-page" aria-label="Your Backpack">
    <header class="backpack-heading"><h1>Backpack</h1><p>Your account, discoveries<br />and everything you’ve<br />picked up along the way.</p></header>
    <AuthorizeView>
        <Authorized>
            <section class="backpack-account" data-passkey-account data-backpack-account data-backpack-home>
                <a class="backpack-settings-shortcut" href="/backpack/settings" aria-label="Account settings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m9 3-1 3-3 1-2 3 2 2v3l3 1 1 3h4l1-3 3-1 2-3-2-2V7l-3-1-1-3Z"/><circle cx="11" cy="11" r="3"/></svg></a>
                <div class="backpack-object">
                    <img class="backpack-scene" src="/pwa/backpack-cabin.png" alt="" width="1183" height="1330" />
                    <div class="backpack-id"><p>EXPLORER ID</p><h2 data-backpack-name>Your Explorer identity</h2><span><AppIcon /> Explorer</span></div>
                    <p class="backpack-identity-status" data-backpack-identity-status role="status">Opening your ID…</p>
                    <div class="backpack-hangers" data-passkey-list aria-live="polite">Loading your passkeys…</div>
                </div>
                <div class="backpack-menu-grid">
                    <a href="/backpack/journey" class="backpack-menu"><span class="backpack-menu-icon draft"><BackpackMenuIcon Name="draft" /></span><span><strong>Continue journey</strong><span data-backpack-draft-summary>Open your unfinished drafts.</span></span><span aria-hidden="true">›</span></a>
                    <a href="/backpack/discoveries" class="backpack-menu"><span class="backpack-menu-icon discovery"><BackpackMenuIcon Name="discovery" /></span><span><strong>My discoveries</strong><span>See the products and places you’ve added to the Atlas.</span></span><span aria-hidden="true">›</span></a>
                    <a href="/backpack/passkeys" class="backpack-menu"><span class="backpack-menu-icon key"><BackpackMenuIcon Name="key" /></span><span><strong>Passkeys</strong><span data-backpack-passkey-copy>Manage the devices you use to sign in.</span></span><span aria-hidden="true">›</span></a>
                    <a href="/backpack/settings" class="backpack-menu"><span class="backpack-menu-icon settings"><BackpackMenuIcon /></span><span><strong>Account settings</strong><span>Profile, preferences and security.</span></span><span aria-hidden="true">›</span></a>
                </div>
                <AntiforgeryToken />
                <p data-passkey-message role="status" aria-live="polite"></p>
                <noscript>Enable JavaScript to open your ID, keys and draft count. The account menus still work.</noscript>
                <a class="backpack-signout" href="/signout" data-enhance-nav="false"><span class="backpack-menu-icon signout"><BackpackMenuIcon Name="signout" /></span><span><strong>Sign out</strong><span>Sign out of your account on this device.</span></span><span aria-hidden="true">›</span></a>
            </section>
        </Authorized>
        <NotAuthorized><div class="backpack-guest"><AppIcon Name="backpack" /><h2>Your personal corner</h2><p>Sign in to open your Explorer ID and manage your passkeys.</p><a href="/signin" data-enhance-nav="false">Sign in</a><a href="/join" data-enhance-nav="false">Create account</a></div></NotAuthorized>
    </AuthorizeView>
    <aside class="backpack-encouragement"><AppIcon Name="map" /><div><h2>Keep exploring</h2><p>Scan products, add discoveries and build your personal map.</p></div><a href="/atlas">Go to Atlas ›</a></aside>
</section>
<section class="pwa-future-page">
    <span class="pwa-coming-soon">Coming soon</span>
    <span class="pwa-future-icon"><AppIcon Name="backpack" /></span>
    <h1>A place for your discoveries.</h1>
    <p>Your Backpack will be a place to keep useful finds close. It isn’t ready just yet.</p>
    <p>There’s plenty to explore in the catalogue while we get things ready.</p>
    <a href="/products" class="ds-button ds-button-primary">Browse products</a>
</section>
