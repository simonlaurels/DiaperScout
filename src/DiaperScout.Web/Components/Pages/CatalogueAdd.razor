    {
        if (submission is null || activeImageRole is null)
            return;

        imageSaving = true;
        saveError = null;

        try
        {
            CatalogueSubmissionImageResult result;

            if (editingImageId is Guid imageId)
            {
                result = await Catalogue.UpdateSubmissionImageMetadataAsync(
                    submission.Id,
