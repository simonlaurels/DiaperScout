    private async Task SaveVerificationAsync()
    {
        if (submission is null || verificationEditorArea is null)
            return;

        if (string.IsNullOrWhiteSpace(verificationEditorSource))
        {
            saveError = "A verification source is required.";
            return;
        }

        saving = true;
        saveError = null;
        saveMessage = null;

        try
        {
            var result = await Catalogue.AddVerificationAsync(
                submission.Id,
                new AddCatalogueSubmissionVerificationRequest(
                    verificationEditorArea.Value,
                    CatalogueVerificationStatus.Verified,
                    VerificationScope(verificationEditorArea.Value),
                    verificationEditorSource.Trim(),
                    string.IsNullOrWhiteSpace(verificationEditorSourceUrl)
                        ? null
                        : verificationEditorSourceUrl.Trim(),
                    string.IsNullOrWhiteSpace(verificationEditorNotes)
                        ? null
                        : verificationEditorNotes.Trim(),
                    null));

            if (result.Status == CatalogueSubmissionVerificationResultStatus.Added)
            {
                verificationEditorArea = null;
                verificationEditorSource = "";
                verificationEditorSourceUrl = null;
                verificationEditorNotes = null;
                await LoadVerificationWorkspaceAsync();
                saveMessage = $"{FormatVerificationArea(result.Receipt!.Area)} verification saved.";
            }
            else if (result.Status == CatalogueSubmissionVerificationResultStatus.Invalid)
            {
                saveError = result.Errors is null
                    ? "The verification could not be saved."
                    : string.Join(" ", result.Errors.SelectMany(value => value.Value));
            }
            else if (result.Status == CatalogueSubmissionVerificationResultStatus.AccessDenied)
            {
                accessDenied = true;
            }
            else
            {
                saveError = result.Message ?? "The verification could not be saved just now.";
            }
        }
        finally
        {
            saving = false;
        }
    }

