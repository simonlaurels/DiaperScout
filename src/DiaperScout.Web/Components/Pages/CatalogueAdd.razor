    private async Task HandleImageSelectedAsync(InputFileChangeEventArgs args)
    {
        saveError = null;
        selectedImageFile = args.File;

        if (selectedImageFile.Size <= 0 || selectedImageFile.Size > 15 * 1024 * 1024)
        {
            selectedImageFile = null;
            saveError = "Images must be greater than zero and no larger than 15 MB.";
            return;
        }

        if (selectedImageFile.ContentType is not "image/jpeg" and not "image/png" and not "image/webp")
        {
