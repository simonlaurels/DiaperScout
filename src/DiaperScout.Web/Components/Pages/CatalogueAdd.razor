    private async Task PublishNowAsync()
    {
        if (submission is null)
            return;

        saving = true;
        saveError = null;
        saveMessage = null;
        accessDenied = false;

        if (submission.Status == CatalogueSubmissionStatus.InVerification)
        {
            var readyResult =
                await Catalogue.MarkReadyForReviewAsync(submission.Id);

            if (readyResult.Status != CatalogueSubmissionResultStatus.Saved)
            {
                Apply(readyResult);
                saving = false;
                return;
            }

            submission = readyResult.Receipt ?? submission;
        }

        if (submission.Status == CatalogueSubmissionStatus.ReadyForReview)
        {
            var reviewResult =
                await Catalogue.ReviewSubmissionAsync(
                    submission.Id,
                    EditorialOutcome.Accepted,
                    "Approved for publication.");

            if (reviewResult.Status == CatalogueSubmissionReviewResultStatus.Invalid)
            {
                saveError = string.Join(
                    " ",
                    reviewResult.Errors!.SelectMany(pair => pair.Value));
                saving = false;
                return;
            }

            if (reviewResult.Status == CatalogueSubmissionReviewResultStatus.AccessDenied)
            {
                accessDenied = true;
                saveError = reviewResult.Message;
                saving = false;
                return;
            }

            if (reviewResult.Status != CatalogueSubmissionReviewResultStatus.Decided)
            {
                saveError = reviewResult.Message;
                saving = false;
                return;
            }

            var approvedResult =
                await Catalogue.GetSubmissionAsync(submission.Id);

            if (approvedResult.Status != CatalogueSubmissionResultStatus.Saved)
            {
                Apply(approvedResult);
                saving = false;
                return;
            }

            submission = approvedResult.Receipt ?? submission;
        }

        if (submission.Status != CatalogueSubmissionStatus.Approved)
        {
            saveError =
                $"This submission is {FormatEnum(submission.Status)} and cannot be published from this screen.";
            saving = false;
            return;
        }

        var result = await Catalogue.PublishSubmissionAsync(submission.Id);

        if (result.Status == CataloguePublicationResultStatus.Published)
        {
            Navigation.NavigateTo("/catalogue/products");
            return;
        }
        else if (result.Status == CataloguePublicationResultStatus.Invalid)
        {
            saveError = string.Join(
                " ",
                result.Errors!.SelectMany(pair => pair.Value));
        }
        else if (result.Status == CataloguePublicationResultStatus.AccessDenied)
        {
            accessDenied = true;
            saveError = result.Message;
        }
        else
        {
            saveError = result.Message;
        }

        saving = false;
    }

    private async Task ReturnToVerificationAsync()
    {
        if (submission is null)
            return;

        saving = true;
        saveError = null;
        saveMessage = null;
        accessDenied = false;

        var result = await Catalogue.ReturnSubmissionToVerificationAsync(
            submission.Id);

        Apply(result);

        if (result.Status == CatalogueSubmissionResultStatus.Saved)
        {
            verificationEditorArea = null;
            await LoadVerificationWorkspaceAsync();
            saveMessage = "Returned to verification. Complete the outstanding verification areas before publishing.";
        }

        saving = false;
    }

    private async Task SaveSpecificationsAsync()
    {
        if (submission is null) return;
        saving = true; saveError = null; accessDenied = false;
        var result = await Catalogue.UpdateSubmissionSpecificationsAsync(
            submission.Id,
            new UpdateCatalogueSubmissionSpecificationsRequest(
                ProposedProductType: detailsModel.ProposedProductType,
                ProposedPackagingType: detailsModel.PackagingType,
                ProposedProductFamily: detailsModel.ProductFamily,
                ProposedDescription: detailsModel.Description,
                ProposedDescriptionVisibility: detailsModel.DescriptionVisibility,
                ProposedProductStatus: detailsModel.ProductStatus,
                ProposedOfficialWebsiteUrl: detailsModel.OfficialWebsiteUrl,
                SharedPrimaryColour: null,
                SharedPrintDesign: null,
                SharedWetnessIndicator: null,
                SharedStandingLeakGuards: null,
                SharedWaistbandStyle: null,
                SharedFragrance: null,
                SharedLatexFree: null,
                SharedDesignedFor: null,
                SharedFastenerCount: null,
                SharedConstructionNotes: null));
        Apply(result);
        saving = false;
        if (submission is not null && result.Status != CatalogueSubmissionResultStatus.Invalid && result.Status != CatalogueSubmissionResultStatus.Failed)
            GoToStep(5);
    }

    private async Task BeginVerificationAsync()
    {
        if (submission is null) return;
        saving = true; saveError = null;
        var result = await Catalogue.BeginVerificationAsync(submission.Id);
        Apply(result);
        saving = false;
        if (submission is not null && result.Status != CatalogueSubmissionResultStatus.Invalid && result.Status != CatalogueSubmissionResultStatus.Failed)
            GoToStep(6);
    }

    private void Apply(CatalogueSubmissionResult result)
    {
        accessDenied = result.Status == CatalogueSubmissionResultStatus.AccessDenied;
        submission = result.Receipt ?? submission;
        if (result.Status == CatalogueSubmissionResultStatus.Invalid)
            saveError = string.Join(" ", result.Errors!.SelectMany(pair => pair.Value));
        else if (result.Status == CatalogueSubmissionResultStatus.Failed)
            saveError = result.Message;
    }

    private void GoToStep(int targetStep)
    {
        targetStep = Math.Clamp(targetStep, 1, 6);

        if (submission is null)
        {
            currentStep = targetStep;
            return;
        }

        // Moving forward through the normal Continue buttons marks that step
        // as reached. Going backwards never reduces the furthest reached step.
        if (targetStep > maxReachedStep && targetStep <= currentStep + 1)
            maxReachedStep = targetStep;

        if (targetStep > maxReachedStep)
            return;

        currentStep = targetStep;
        Navigation.NavigateTo(
            $"/catalogue/add/{submission.Id}/{currentStep}?maxStep={maxReachedStep}");
    }

    private bool IsStepNavigable(int step) =>
        submission is not null &&
        step <= maxReachedStep &&
        step != currentStep;

    private void NavigateToStepFromTab(int targetStep)
    {
        if (IsStepNavigable(targetStep))
            GoToStep(targetStep);
    }

    private void HandleStepKeyDown(KeyboardEventArgs e, int targetStep)
    {
        if (!IsStepNavigable(targetStep))
            return;

        if (e.Key is "Enter" or " ")
            GoToStep(targetStep);
    }

    private string StepClass(int step) =>
        step == currentStep
            ? "submission-step-active"
            : step <= maxReachedStep
                ? "submission-step-complete"
                : "";

    private static string FormatEnum<T>(T value)
    {
        var name = value?.ToString() ?? string.Empty;

        if (typeof(T) == typeof(ProductType) && string.Equals(name, "Tape", StringComparison.Ordinal))
            return "Diaper";

        return System.Text.RegularExpressions.Regex.Replace(name, "(?<!^)([A-Z])", " $1");
    }

