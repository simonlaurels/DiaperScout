                    new UpdateCatalogueSubmissionImageMetadata(
                        imageEditor.SourceType,
                        imageEditor.SourceUrl,
                        imageEditor.SourceNotes,
                        imageEditor.PermissionStatus,
                        imageEditor.PermissionEvidence));
            }
            else
            {
                if (selectedImageFile is null)
                {
                    saveError = "Choose an image file first.";
                    return;
                }

                result = await Catalogue.AddSubmissionImageAsync(
                    submission.Id,
                    activeImageRole.Value,
                    selectedImageFile,
                    imageEditor.SourceType,
                    imageEditor.SourceUrl,
                    imageEditor.SourceNotes,
                    imageEditor.PermissionStatus,
                    imageEditor.PermissionEvidence);
            }

            if (result.Status == CatalogueSubmissionImageResultStatus.Saved)
            {
                CancelImageEdit();
                await LoadImagesAsync();
