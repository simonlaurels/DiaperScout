            else if (result.Status == CatalogueSubmissionImageResultStatus.Invalid)
            {
                saveError = result.Errors is null
                    ? "The image could not be saved."
                    : string.Join(" ", result.Errors.SelectMany(value => value.Value));
            }
            else if (result.Status == CatalogueSubmissionImageResultStatus.AccessDenied)
            {
                accessDenied = true;
            }
            else
            {
                saveError = "The image could not be saved just now.";
