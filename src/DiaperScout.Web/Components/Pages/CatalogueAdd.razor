    private async Task SaveSizeAsync()
    {
        if (submission is null || editingSizeVariantId is null)
            return;

        var manufacturerSize = sizeEditor.ManufacturerSize?.Trim();

        if (string.IsNullOrWhiteSpace(manufacturerSize))
        {
            saveError = "Manufacturer size is required.";
            return;
        }

        saving = true;
        saveError = null;

        try
        {
            var request = new UpdateCatalogueSubmissionSizeVariantRequest(
                manufacturerSize,
                sizeEditor.WaistMinimumCm,
                sizeEditor.WaistMaximumCm,
                sizeEditor.HipMinimumCm,
                sizeEditor.HipMaximumCm,
                sizeEditor.ManufacturerStatedAbsorbencyMl,
                sizeEditor.FitMeasurementBasis,
                sizeEditor.AbsorbencyBasisMethod,
                sizeEditor.AbsorbencySource,
                sizeEditor.LengthMm,
                sizeEditor.WidthMm,
                sizeEditor.WeightGrams,
                sizeEditor.ManufacturerPackQuantity,
                sizeEditor.Gtin);

            CatalogueSubmissionSizeVariantResult result;

            if (editingSizeId is null)
            {
                result = await Catalogue.AddSubmissionSizeVariantAsync(
                    submission.Id,
                    editingSizeVariantId.Value,
                    new AddCatalogueSubmissionSizeVariantRequest(
                        request.ManufacturerSize,
                        request.WaistMinimumCm,
                        request.WaistMaximumCm,
                        request.HipMinimumCm,
                        request.HipMaximumCm,
                        request.ManufacturerStatedAbsorbencyMl,
                        request.FitMeasurementBasis,
                        request.AbsorbencyBasisMethod,
                        request.AbsorbencySource,
                        request.LengthMm,
                        request.WidthMm,
                        request.WeightGrams,
                        request.ManufacturerPackQuantity,
                        request.Gtin));
            }
            else
            {
                result = await Catalogue.UpdateSubmissionSizeVariantAsync(
                    submission.Id,
                    editingSizeVariantId.Value,
                    editingSizeId.Value,
                    request);
            }

            if (result.Status == CatalogueSubmissionSizeVariantResultStatus.Saved)
            {
                // Sizes are entered against Original/base first. When a new size
                // is added there, seed that size into every existing named
                // variant. Copies are independent afterwards; GTIN is never
                // propagated.
                if (editingSizeId is null)
                {
                    var originalVariant = variants.FirstOrDefault(value => value.Name is null);

                    if (originalVariant is not null &&
                        editingSizeVariantId.Value == originalVariant.Id)
                    {
                        foreach (var namedVariant in variants.Where(value => value.Name is not null))
                        {
                            var alreadyExists = GetSizes(namedVariant.Id)
                                .Any(value => string.Equals(
                                    value.ManufacturerSize?.Trim(),
                                    request.ManufacturerSize,
                                    StringComparison.OrdinalIgnoreCase));

                            if (alreadyExists)
                                continue;

                            var copyResult = await Catalogue.AddSubmissionSizeVariantAsync(
                                submission.Id,
                                namedVariant.Id,
                                new AddCatalogueSubmissionSizeVariantRequest(
                                    request.ManufacturerSize,
                                    request.WaistMinimumCm,
                                    request.WaistMaximumCm,
                                    request.HipMinimumCm,
                                    request.HipMaximumCm,
                                    request.ManufacturerStatedAbsorbencyMl,
                                    request.FitMeasurementBasis,
                                    request.AbsorbencyBasisMethod,
                                    request.AbsorbencySource,
                                    request.LengthMm,
                                    request.WidthMm,
                                    request.WeightGrams,
                                    request.ManufacturerPackQuantity,
                                    null));

                            if (copyResult.Status != CatalogueSubmissionSizeVariantResultStatus.Saved)
                            {
                                saveError = $"The Original size was saved, but it could not be copied to {namedVariant.Name}. {copyResult.Message}".Trim();
                                break;
                            }
                        }
                    }
                }

                await LoadSizeVariantsAsync();
                CancelEditSize();
            }
            else if (result.Status == CatalogueSubmissionSizeVariantResultStatus.Invalid)
            {
                saveError = string.Join(" ", result.Errors!.SelectMany(pair => pair.Value));
            }
            else if (result.Status == CatalogueSubmissionSizeVariantResultStatus.AccessDenied)
            {
                accessDenied = true;
            }
            else
            {
                saveError = result.Message;
            }
        }
        catch (Exception exception)
        {
            saveError = exception.Message;
        }
        finally
        {
            saving = false;
        }
    }

