    private async Task SaveVariantAsync()
    {
        if (submission is null)
            return;

        saving = true;
        saveError = null;
        accessDenied = false;

        try
        {
            CatalogueSubmissionVariantResult result;

            if (addingBaseVariant)
            {
                result = await Catalogue.AddSubmissionBaseVariantAsync(
                    submission.Id);
            }
            else if (addingVariant)
            {
                if (string.IsNullOrWhiteSpace(variantEditorName))
                {
                    saveError = "A named variant requires a manufacturer-defined name.";
                    return;
                }

                result = await Catalogue.AddSubmissionNamedVariantAsync(
                    submission.Id,
                    variantEditorName.Trim());
            }
            else if (editingVariant is not null)
            {
                if (string.IsNullOrWhiteSpace(variantEditorName))
                {
                    saveError = "A named variant requires a manufacturer-defined name.";
                    return;
                }

                result = await Catalogue.UpdateSubmissionVariantAsync(
                    submission.Id,
                    editingVariant.Id,
                    new UpdateCatalogueSubmissionVariantRequest(variantEditorName.Trim()));
            }
            else
            {
                return;
            }

            if (result.Status != CatalogueSubmissionVariantResultStatus.Saved || result.Variant is null)
            {
                if (result.Status == CatalogueSubmissionVariantResultStatus.Invalid && result.Errors is not null)
                    saveError = string.Join(" ", result.Errors.SelectMany(pair => pair.Value));
                else if (result.Status == CatalogueSubmissionVariantResultStatus.AccessDenied)
                {
                    accessDenied = true;
                    saveError = result.Message;
                }
                else
                    saveError = result.Message ?? "The variant could not be saved.";

                return;
            }

            // Save all variant attributes before closing the editor. If one
            // attribute fails, keep the editor open so the failure is visible
            // and the moderator can correct it instead of silently discarding
            // the edited values.
            var overrideError = await SaveVariantOverrideAsync(result.Variant.Id);
            if (overrideError is not null)
            {
                saveError = overrideError;
                return;
            }

            // A new named variant starts as a copy of the first existing
            // variant's sizes. The moderator can then adjust the copied values
            // before saving. GTINs are deliberately not copied because
            // identifiers are globally unique.
            if (addingVariant && variantCopySourceId is not null)
            {
                var sourceSizes = GetSizes(variantCopySourceId.Value);

                foreach (var size in sourceSizes)
                {
                    var copyResult = await Catalogue.AddSubmissionSizeVariantAsync(
                        submission.Id,
                        result.Variant.Id,
                        new AddCatalogueSubmissionSizeVariantRequest(
                            size.ManufacturerSize,
                            size.WaistMinimumCm,
                            size.WaistMaximumCm,
                            size.HipMinimumCm,
                            size.HipMaximumCm,
                            size.ManufacturerStatedAbsorbencyMl,
                            size.FitMeasurementBasis,
                            size.AbsorbencyBasisMethod,
                            size.AbsorbencySource,
                            size.LengthMm,
                            size.WidthMm,
                            size.WeightGrams,
                            size.ManufacturerPackQuantity,
                            null));

                    if (copyResult.Status != CatalogueSubmissionSizeVariantResultStatus.Saved)
                    {
                        saveError = $"The variant was saved, but its sizes could not all be copied. {copyResult.Message}".Trim();
                        return;
                    }
                }
            }

            await LoadVariantsAsync();
            CancelEditVariant();
        }
        catch (Exception exception)
        {
            saveError = $"The variant could not be saved: {exception.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task<string?> SaveVariantOverrideAsync(Guid variantId)
    {
        var values = new (CatalogueVariantOverrideAttribute Attribute, string? Value)[]
        {
            (CatalogueVariantOverrideAttribute.BackingType, variantEditor.BackingType?.ToString()),
            (CatalogueVariantOverrideAttribute.FastenerType, variantEditor.FastenerType?.ToString()),
            (CatalogueVariantOverrideAttribute.Appearance, variantEditor.Appearance?.ToString()),
            (CatalogueVariantOverrideAttribute.PrimaryColour, variantEditor.PrimaryColour?.ToString()),
            (CatalogueVariantOverrideAttribute.WetnessIndicator, variantEditor.HasWetnessIndicator?.ToString()),
            (CatalogueVariantOverrideAttribute.StandingLeakGuards, variantEditor.HasStandingLeakGuards?.ToString()),
            (CatalogueVariantOverrideAttribute.WaistbandStyle, variantEditor.WaistbandStyle?.ToString()),
            (CatalogueVariantOverrideAttribute.Fragrance, variantEditor.Fragrance?.ToString()),
            (CatalogueVariantOverrideAttribute.LatexFree, variantEditor.IsLatexFree?.ToString()),
            (CatalogueVariantOverrideAttribute.DesignedFor, variantEditor.DesignedFor?.ToString()),
            (CatalogueVariantOverrideAttribute.FastenerCount, variantEditor.FastenerCount?.ToString()),
            (CatalogueVariantOverrideAttribute.ConstructionNotes, variantEditor.ConstructionNotes)
        };

        foreach (var value in values)
        {
            var result = await Catalogue.UpdateSubmissionVariantOverrideAsync(
                submission!.Id,
                variantId,
                new UpdateCatalogueSubmissionVariantOverrideRequest(value.Attribute, value.Value));

            if (result.Status != CatalogueSubmissionVariantOverrideResultStatus.Saved)
            {
                var attributeName = FormatEnum(value.Attribute);
                return $"Could not save {attributeName}: {result.Message ?? "The variant attribute could not be saved."}";
            }
        }

        return null;
    }

