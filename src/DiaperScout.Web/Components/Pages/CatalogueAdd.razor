@using Microsoft.AspNetCore.Components.Web
@page "/catalogue/add"
@page "/catalogue/add/{submissionId:guid}/{step:int}"
@using Microsoft.AspNetCore.Components.Forms
@rendermode InteractiveServer
@inject ProductCatalogueClient Catalogue
@inject NavigationManager Navigation

<PageTitle>Add Product · DiaperScout</PageTitle>

<section class="submission-page">
    <div class="submission-container">
        <header class="submission-header">
            <div>
                <p class="catalogue-kicker">CATALOGUE WORKSPACE</p>
                <h1>Add a product</h1>
                <p class="submission-intro">Build the catalogue entry step by step. Nothing becomes part of the public catalogue until verification and publication are complete.</p>
            </div>
            @if (submission is not null)
            {
                <div class="submission-status">
                    <span>Submission</span>
                    <strong>@FormatEnum(submission.Status)</strong>
                </div>
            }
        </header>

        @if (accessDenied)
        {
            <div class="submission-message submission-message-error" role="alert">
                <strong>Catalogue workspace unavailable</strong>
                <p>You need Moderator editorial authority to add catalogue products.</p>
            </div>
        }
        else if (saveError is not null)
        {
            <div class="submission-message submission-message-error" role="alert">@saveError</div>
        }
        else if (saveMessage is not null)
        {
            <div class="submission-message submission-message-success" role="status">@saveMessage</div>
        }

        <ol class="submission-steps" aria-label="Product creation progress">
            <li class="@(StepClass(1)) @(IsStepNavigable(1) ? "submission-step-navigable" : "")"
                @onclick="() => NavigateToStepFromTab(1)"
                @onkeydown="(e) => HandleStepKeyDown(e, 1)"
                tabindex="@(IsStepNavigable(1) ? 0 : -1)"
                role="@(IsStepNavigable(1) ? "button" : null)">
                <span>1</span><div><strong>Identity</strong><small>What is it?</small></div>
            </li>
            <li class="@(StepClass(2)) @(IsStepNavigable(2) ? "submission-step-navigable" : "")"
                @onclick="() => NavigateToStepFromTab(2)"
                @onkeydown="(e) => HandleStepKeyDown(e, 2)"
                tabindex="@(IsStepNavigable(2) ? 0 : -1)"
                role="@(IsStepNavigable(2) ? "button" : null)">
                <span>2</span><div><strong>Variants</strong><small>What versions?</small></div>
            </li>
            <li class="@(StepClass(3)) @(IsStepNavigable(3) ? "submission-step-navigable" : "")"
                @onclick="() => NavigateToStepFromTab(3)"
                @onkeydown="(e) => HandleStepKeyDown(e, 3)"
                tabindex="@(IsStepNavigable(3) ? 0 : -1)"
                role="@(IsStepNavigable(3) ? "button" : null)">
                <span>3</span><div><strong>Sizes</strong><small>What sizes?</small></div>
            </li>
            <li class="@(StepClass(4)) @(IsStepNavigable(4) ? "submission-step-navigable" : "")"
                @onclick="() => NavigateToStepFromTab(4)"
                @onkeydown="(e) => HandleStepKeyDown(e, 4)"
                tabindex="@(IsStepNavigable(4) ? 0 : -1)"
                role="@(IsStepNavigable(4) ? "button" : null)">
                <span>4</span><div><strong>Details</strong><small>Product facts</small></div>
            </li>
            <li class="@(StepClass(5)) @(IsStepNavigable(5) ? "submission-step-navigable" : "")"
                @onclick="() => NavigateToStepFromTab(5)"
                @onkeydown="(e) => HandleStepKeyDown(e, 5)"
                tabindex="@(IsStepNavigable(5) ? 0 : -1)"
                role="@(IsStepNavigable(5) ? "button" : null)">
                <span>5</span><div><strong>Images</strong><small>Images &amp; rights</small></div>
            </li>
            <li class="@(StepClass(6)) @(IsStepNavigable(6) ? "submission-step-navigable" : "")"
                @onclick="() => NavigateToStepFromTab(6)"
                @onkeydown="(e) => HandleStepKeyDown(e, 6)"
                tabindex="@(IsStepNavigable(6) ? 0 : -1)"
                role="@(IsStepNavigable(6) ? "button" : null)">
                <span>6</span><div><strong>Verify</strong><small>Ready to catalogue</small></div>
            </li>
        </ol>

        @if (submission is null)
        {
            <EditForm Model="createModel" OnValidSubmit="CreateAsync" FormName="catalogue-create" class="submission-form">
                <div class="submission-panel">
                    <div class="submission-panel-heading">
                        <div><p class="catalogue-kicker">STEP 1 OF 6</p><h2>Product Identity</h2></div>
                        <span class="submission-required">Required</span>
                    </div>
                    <p class="submission-help">Tell us what product we're adding. Variants, sizes and the remaining product details are added in the following steps.</p>

                    <div class="submission-field submission-field-wide">
                        <label for="manufacturer-search">Business Name <span>*</span></label>
                        <small>The business associated with the product or brand.</small>
                        <div class="submission-choice-row" role="radiogroup" aria-label="Business name entry method">
                            <label class="submission-choice">
                                <input type="radio" name="manufacturer-mode" value="existing" checked="@(manufacturerMode == "existing")" @onchange="SetManufacturerExisting" />
                                <span>Select existing</span>
                            </label>
                            <label class="submission-choice">
                                <input type="radio" name="manufacturer-mode" value="new" checked="@(manufacturerMode == "new")" @onchange="SetManufacturerNew" />
                                <span>Add new</span>
                            </label>
                        </div>
                        @if (manufacturerMode == "existing")
                        {
                            <InputText id="manufacturer-search" class="ds-input" @bind-Value="createModel.ProposedManufacturerName" placeholder="Search businesses..." />
                        }
                        else
                        {
                            <InputText id="manufacturer-new" class="ds-input" @bind-Value="createModel.ProposedManufacturerName" placeholder="Business name..." />
                        }
                    </div>

                    <div class="submission-field submission-field-wide">
                        <label for="brand-search">Brand <span class="required-marker">*</span></label>
                        <small>The consumer-facing brand under which the product is sold.</small>
                        <div class="submission-choice-row" role="radiogroup" aria-label="Brand entry method">
                            <label class="submission-choice">
                                <input type="radio" name="brand-mode" value="existing" checked="@(brandMode == "existing")" @onchange="SetBrandExisting" />
                                <span>Select existing</span>
                            </label>
                            <label class="submission-choice">
                                <input type="radio" name="brand-mode" value="new" checked="@(brandMode == "new")" @onchange="SetBrandNew" />
                                <span>Add new</span>
                            </label>
                        </div>
                        @if (brandMode == "existing")
                        {
                            <InputText id="brand-search" class="ds-input" @bind-Value="createModel.ProposedBrandName" placeholder="Search brands..." />
                        }
                        else
                        {
                            <InputText id="brand-new" class="ds-input" @bind-Value="createModel.ProposedBrandName" placeholder="Brand name..." />
                        }
                    </div>

                    <div class="submission-field submission-field-wide">
                        <label for="product">Product name <span>*</span></label>
                        <small>The specific product being catalogued.</small>
                        <InputText id="product" class="ds-input" @bind-Value="createModel.ProposedProductName" />
                        <small>💡 Enter the product name as identified by the manufacturer. Don't strip meaningful product naming to create an artificial core name.</small>
                        <div class="submission-example">
                            <span><strong>Example:</strong> TENA Slip Active Fit Maxi</span>
                            <span><strong>Not:</strong> TENA Slip Active Fit</span>
                        </div>
                    </div>
                </div>

                <div class="submission-actions">
                    <button class="ds-button ds-button-primary" type="submit" disabled="@saving">@(saving ? "Creating…" : "Continue →")</button>
                </div>
            </EditForm>
        }
        else
        {
            @if (currentStep == 1)
            {
                <section class="submission-panel">
                    <div class="submission-panel-heading">
                        <div><p class="catalogue-kicker">STEP 1 OF 6</p><h2>Product Identity</h2></div>
                        <span class="submission-complete">Saved</span>
                    </div>
                    <div class="submission-summary">
                        <div><span>Business Name</span><strong>@submission.ProposedManufacturerName</strong></div>
                        @if (!string.IsNullOrWhiteSpace(submission.ProposedBrandName)) { <div><span>Brand</span><strong>@submission.ProposedBrandName</strong></div> }
                        <div><span>Product</span><strong>@submission.ProposedProductName</strong></div>
                    </div>
                    <div class="submission-actions"><button class="ds-button ds-button-primary" type="button" @onclick="() => GoToStep(2)">Continue →</button></div>
                </section>
            }
            else if (currentStep == 2)
            {
                <section class="submission-panel">
                    <div class="submission-panel-heading">
                        <div><p class="catalogue-kicker">STEP 2 OF 6</p><h2>Product Variants</h2></div>
                    </div>
                    <div class="submission-context">
                        <span>PRODUCT</span>
                        <strong>@submission.ProposedProductName</strong>
                    </div>
                    <p class="submission-help">Add the versions that users should be able to switch between on this product page. Use a base variant only when this product has a base version without a separate manufacturer-defined variant name. Related products should not be collapsed into variants just because their names are similar.</p>

                    <div class="submission-section-label">VARIANTS</div>

                    @if (variantsLoading)
                    {
                        <div class="submission-card"><small>Loading variants…</small></div>
                    }
                    else
                    {
                        @if (variants.Count == 0)
                        {
                            <div class="submission-card submission-card-muted">
                                <strong>No variants added yet</strong>
                                <small>Add the base product or one or more named variants below.</small>
                            </div>
                        }

                        @foreach (var variant in variants)
                        {
                            <div class="submission-card">
                                <div>
                                    <strong>@(variant.Name ?? "Original version")</strong>
                                    <small>@(variant.Name is null ? "Base product · No separate variant name" : "Named product variant")</small>
                                </div>
                                <div class="submission-card-actions">
                                    <button class="ds-button ds-button-secondary" type="button" @onclick="() => BeginEditVariant(variant)">Edit</button>
                                    @if (variant.Name is not null || variants.Count > 1)
                                    {
                                        <button class="ds-button ds-button-secondary" type="button" @onclick="() => RemoveVariantAsync(variant)" disabled="@saving">Remove</button>
                                    }
                                </div>
                            </div>
                        }

                        @if (editingVariant is not null || addingVariant || addingBaseVariant)
                        {
                            <div class="submission-card submission-card-editor">
                                <div class="submission-field submission-field-wide">
                                    @if (addingBaseVariant)
                                    {
                                        <label>Base product</label>
                                        <div class="submission-context"><strong>Original version</strong><span>No separate manufacturer-defined variant name.</span></div>
                                    }
                                    else
                                    {
                                        <label for="variant-name">Variant name</label>
                                        <div style="display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:.75rem;width:100%;">
                                            <InputText id="variant-name" class="ds-input" @bind-Value="variantEditorName" />
                                            <div class="submission-card-actions" style="align-self:center;">
                                                <button class="ds-button ds-button-secondary" type="button" @onclick="CancelEditVariant">Cancel</button>
                                                <button class="ds-button ds-button-primary" type="button" @onclick="SaveVariantAsync">Save</button>
                                            </div>
                                        </div>
                                        <small>Enter the manufacturer's meaningful variant name. Don't include size, pack quantity or barcode information.</small>
                                    }
                                </div>

                                <div class="submission-grid submission-variant-attributes">
                                    <div class="submission-field"><label>Backing type</label><InputSelect class="ds-select" @bind-Value="variantEditor.BackingType"><option value="">Unknown</option>@foreach (var value in Enum.GetValues<BackingType>().Where(value => value != BackingType.Unknown)) { <option value="@value">@FormatEnum(value)</option> }</InputSelect></div>
                                    <div class="submission-field"><label>Fastener type</label><InputSelect class="ds-select" @bind-Value="variantEditor.FastenerType"><option value="">Unknown</option>@foreach (var value in Enum.GetValues<FastenerType>().Where(value => value != FastenerType.Unknown)) { <option value="@value">@FormatEnum(value)</option> }</InputSelect></div>
                                    <div class="submission-field"><label>Fastener count</label><InputNumber class="ds-input" @bind-Value="variantEditor.FastenerCount" /></div>
                                    <div class="submission-field"><label>Primary colour</label><InputSelect class="ds-select" @bind-Value="variantEditor.PrimaryColour"><option value="">Unknown</option>@foreach (var value in Enum.GetValues<CatalogueVariantColour>().Where(value => value != CatalogueVariantColour.Unknown)) { <option value="@value">@FormatEnum(value)</option> }</InputSelect></div>
                                    <div class="submission-field"><label>Appearance</label><InputSelect class="ds-select" @bind-Value="variantEditor.Appearance"><option value="">Unknown</option>@foreach (var value in Enum.GetValues<CatalogueVariantAppearance>().Where(value => value != CatalogueVariantAppearance.Unknown)) { <option value="@value">@FormatEnum(value)</option> }</InputSelect></div>
                                    <div class="submission-field"><label>Wetness indicator</label><InputSelect class="ds-select" @bind-Value="variantEditor.HasWetnessIndicator"><option value="">Unknown</option><option value="true">Yes</option><option value="false">No</option></InputSelect></div>
                                    <div class="submission-field"><label>Standing leak guards</label><InputSelect class="ds-select" @bind-Value="variantEditor.HasStandingLeakGuards"><option value="">Unknown</option><option value="true">Yes</option><option value="false">No</option></InputSelect></div>
                                    <div class="submission-field"><label>Waistband style</label><InputSelect class="ds-select" @bind-Value="variantEditor.WaistbandStyle"><option value="">Unknown</option>@foreach (var value in Enum.GetValues<WaistbandStyle>().Where(value => value != WaistbandStyle.Unknown)) { <option value="@value">@FormatEnum(value)</option> }</InputSelect></div>
                                    <div class="submission-field"><label>Fragrance</label><InputSelect class="ds-select" @bind-Value="variantEditor.Fragrance"><option value="">Unknown</option>@foreach (var value in Enum.GetValues<FragranceType>().Where(value => value != FragranceType.Unknown)) { <option value="@value">@FormatEnum(value)</option> }</InputSelect></div>
                                    <div class="submission-field"><label>Latex free</label><InputSelect class="ds-select" @bind-Value="variantEditor.IsLatexFree"><option value="">Unknown</option><option value="true">Yes</option><option value="false">No</option></InputSelect></div>
                                    <div class="submission-field"><label>Designed for</label><InputSelect class="ds-select" @bind-Value="variantEditor.DesignedFor"><option value="">Unknown</option>@foreach (var value in Enum.GetValues<CatalogueVariantDesignedFor>().Where(value => value != CatalogueVariantDesignedFor.Unknown)) { <option value="@value">@FormatEnum(value)</option> }</InputSelect></div>
                                    <div class="submission-field submission-field-wide"><label>Construction notes</label><InputTextArea class="ds-input ds-textarea" @bind-Value="variantEditor.ConstructionNotes" rows="3" /></div>
                                </div>
                                @if (addingBaseVariant)
                                {
                                    <div class="submission-card-actions">
                                        <button class="ds-button ds-button-secondary" type="button" @onclick="CancelEditVariant">Cancel</button>
                                        <button class="ds-button ds-button-primary" type="button" @onclick="SaveVariantAsync">Save</button>
                                    </div>
                                }
                            </div>
                        }

                        @if (editingVariant is null && !addingVariant && !addingBaseVariant)
                        {
                            <div class="submission-card submission-card-muted submission-card-add">
                                <div class="submission-card-actions">
                                    @if (!variants.Any(value => value.Name is null))
                                    {
                                        <button class="ds-button ds-button-secondary" type="button" @onclick="BeginAddBaseVariant" disabled="@saving">＋ Add original product</button>
                                    }
                                    <button class="ds-button ds-button-secondary" type="button" @onclick="BeginAddVariant" disabled="@saving">＋ Add named variant</button>
                                </div>
                            </div>
                        }
                    }

                    <div class="submission-tip">
                        <strong>💡 Keep the hierarchy clean.</strong>
                        <span>Use variants for meaningful alternatives on the same product page. Don't use them to combine separate products, and don't add size, pack quantity or barcode information here.</span>
                    </div>

                    <div class="submission-next">
                        <div><p class="catalogue-kicker">NEXT</p><h2>Size Variants</h2><p>Each product variant can have its own physical sizes.</p></div>
                        <div class="submission-card-actions">
                            <button class="ds-button ds-button-secondary" type="button" @onclick="() => GoToStep(1)">← Back</button>
                            <button class="ds-button ds-button-primary" type="button" @onclick="() => GoToStep(3)" disabled="@(editingVariant is not null || addingVariant || addingBaseVariant || variants.Count == 0)">Continue →</button>
                        </div>
                    </div>
                </section>
            }
            else if (currentStep == 3)
            {
                <section class="submission-panel">
                    <div class="submission-panel-heading"><div><p class="catalogue-kicker">STEP 3 OF 6</p><h2>Size Variants</h2></div></div>
                    <p class="submission-help">Add the physical sizes available for each product variant. Size-specific manufacturer information can differ between sizes. Leave information blank when it is not known or published.</p>

                    @if (variantsLoading)
                    {
                        <div class="submission-card submission-card-muted"><strong>Loading sizes…</strong></div>
                    }
                    else
                    {
                        @foreach (var variant in variants)
                        {
                            <div class="submission-card submission-size-variant">
                                <div class="submission-card-heading">
                                    <div>
                                        <strong>@(variant.Name ?? "Original / base product")</strong>
                                        <small>@GetSizes(variant.Id).Count size@(GetSizes(variant.Id).Count == 1 ? "" : "s")</small>
                                    </div>
                                    <button class="ds-button ds-button-secondary" type="button" @onclick="() => BeginAddSize(variant.Id)" disabled="@saving">＋ Add size</button>
                                </div>

                                @if (editingSizeVariantId == variant.Id)
                                {
                                    <div class="submission-size-editor">
                                    <div class="submission-grid">
                                        <div class="submission-field submission-field-wide">
                                            <label>Manufacturer size *</label>
                                            <input class="ds-input" @bind="sizeEditor.ManufacturerSize" @bind:event="oninput" placeholder="e.g. Medium" />
                                        </div>
                                        <div class="submission-field"><label>Waist minimum (cm)</label><InputNumber class="ds-input" @bind-Value="sizeEditor.WaistMinimumCm" /></div>
                                        <div class="submission-field"><label>Waist maximum (cm)</label><InputNumber class="ds-input" @bind-Value="sizeEditor.WaistMaximumCm" /></div>
                                        <div class="submission-field"><label>Hip minimum (cm)</label><InputNumber class="ds-input" @bind-Value="sizeEditor.HipMinimumCm" /></div>
                                        <div class="submission-field"><label>Hip maximum (cm)</label><InputNumber class="ds-input" @bind-Value="sizeEditor.HipMaximumCm" /></div>
                                        <div class="submission-field submission-field-wide"><label>Fit measurement basis</label><InputText class="ds-input" @bind-Value="sizeEditor.FitMeasurementBasis" placeholder="e.g. Waist and hip; use larger measurement" /></div>
                                        <div class="submission-field"><label>Manufacturer-stated absorbency (ml)</label><InputNumber class="ds-input" @bind-Value="sizeEditor.ManufacturerStatedAbsorbencyMl" /></div>
                                        <div class="submission-field"><label>Absorbency basis / method</label><InputText class="ds-input" @bind-Value="sizeEditor.AbsorbencyBasisMethod" /></div>
                                        <div class="submission-field submission-field-wide"><label>Absorbency source / provenance</label><InputText class="ds-input" @bind-Value="sizeEditor.AbsorbencySource" /></div>
                                        <div class="submission-field"><label>Length (mm)</label><InputNumber class="ds-input" @bind-Value="sizeEditor.LengthMm" /></div>
                                        <div class="submission-field"><label>Width (mm)</label><InputNumber class="ds-input" @bind-Value="sizeEditor.WidthMm" /></div>
                                        <div class="submission-field"><label>Weight (g)</label><InputNumber class="ds-input" @bind-Value="sizeEditor.WeightGrams" /></div>
                                        <div class="submission-field"><label>Manufacturer pack quantity</label><InputNumber class="ds-input" @bind-Value="sizeEditor.ManufacturerPackQuantity" /><small>Number of individual products stated by the manufacturer as supplied in the standard pack for this size.</small></div>
                                        <div class="submission-field submission-field-wide"><label>GTIN / barcode</label><InputText class="ds-input" @bind-Value="sizeEditor.Gtin" placeholder="8–14 digits" /></div>
                                    </div>
                                    <div class="submission-actions">
                                        <button class="ds-button ds-button-secondary" type="button" @onclick="CancelEditSize" disabled="@saving">Cancel</button>
                                        <button class="ds-button ds-button-primary" type="button" @onclick="SaveSizeAsync" disabled="@saving">@(saving ? "Saving…" : "Save size")</button>
                                    </div>
                                    </div>
                                }
                                else if (GetSizes(variant.Id).Count == 0)
                                {
                                    <div class="submission-card submission-card-muted">
                                        @if (variant.Name is not null && variants.Any(value => value.Name is null) && GetSizes(variants.First(value => value.Name is null).Id).Count > 0)
                                        {
                                            <small>No sizes are currently assigned to this variant. New named variants normally start with a copy of the Original version's sizes; you can add or remove sizes independently here.</small>
                                        }
                                        else
                                        {
                                            <small>No sizes added yet. Add at least one size before continuing.</small>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="submission-size-list">
                                        @foreach (var size in GetSizes(variant.Id).OrderBy(GetSizeSortKey))
                                        {
                                            <div class="submission-card submission-size-card">
                                                <div class="submission-card-heading">
                                                    <div>
                                                        <strong>@size.ManufacturerSize</strong>
                                                        <small>@FormatSizeSummary(size)</small>
                                                    </div>
                                                    <div class="submission-card-actions">
                                                        <button class="ds-button ds-button-secondary" type="button" @onclick="() => BeginEditSize(variant.Id, size)" disabled="@saving">Edit</button>
                                                        <button class="ds-button ds-button-danger" type="button" @onclick="() => RemoveSizeAsync(variant.Id, size)" disabled="@saving">Remove</button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }

                    <div class="submission-next">
                        <div><p class="catalogue-kicker">NEXT</p><h2>Product Details</h2><p>Capture the remaining factual information about the product as a whole.</p></div>
                        <div class="submission-card-actions">
                            <button class="ds-button ds-button-secondary" type="button" @onclick="() => GoToStep(2)">← Back</button>
                            <button class="ds-button ds-button-primary" type="button" @onclick="() => GoToStep(4)" disabled="@(saving || editingSizeVariantId is not null || variants.Count == 0 || variants.Any(variant => GetSizes(variant.Id).Count == 0))">Continue →</button>
                        </div>
                    </div>
                </section>
            }
            else if (currentStep == 4)
            {
                <EditForm Model="detailsModel" OnValidSubmit="SaveSpecificationsAsync" FormName="catalogue-details" class="submission-panel">
                    <div class="submission-panel-heading"><div><p class="catalogue-kicker">STEP 4 OF 6</p><h2>Product Details</h2></div></div>
                    <p class="submission-help">Add the factual details that describe this product as a whole. Variant-specific and size-specific information is captured separately.</p>
                    <div class="submission-grid">
                        <div class="submission-field"><label for="type">Product type</label><InputSelect id="type" class="ds-select" @bind-Value="detailsModel.ProposedProductType"><option value="">Unknown</option>@foreach (var value in Enum.GetValues<ProductType>()) { <option value="@value">@FormatEnum(value)</option> }</InputSelect></div>
                        <div class="submission-field"><label for="family">Product family</label><InputText id="family" class="ds-input" @bind-Value="detailsModel.ProductFamily" /></div>
                        <div class="submission-field submission-field-wide"><label for="description">Description</label><InputTextArea id="description" class="ds-input ds-textarea" @bind-Value="detailsModel.Description" rows="5" /></div>
                        <div class="submission-field"><label for="status">Product status</label><InputSelect id="status" class="ds-select" @bind-Value="detailsModel.ProductStatus"><option value="">Unknown</option>@foreach (var value in Enum.GetValues<ProductStatus>()) { <option value="@value">@FormatEnum(value)</option> }</InputSelect></div>
                        <div class="submission-field"><label for="packaging">Packaging type</label><InputSelect id="packaging" class="ds-select" @bind-Value="detailsModel.PackagingType"><option value="">Unknown</option>@foreach (var value in Enum.GetValues<PackagingType>()) { <option value="@value">@FormatEnum(value)</option> }</InputSelect></div>
                        <div class="submission-field submission-field-wide"><label for="website">Official website</label><InputText id="website" class="ds-input" @bind-Value="detailsModel.OfficialWebsiteUrl" placeholder="https://…" /></div>
                    </div>
                    <div class="submission-actions"><button class="ds-button ds-button-primary" type="submit" disabled="@saving">Continue →</button></div>
                </EditForm>
            }
            else if (currentStep == 5)
            {
                <section class="submission-panel">
                    <div class="submission-panel-heading">
                        <div><p class="catalogue-kicker">STEP 5 OF 6</p><h2>Images</h2></div>
                    </div>
                    <p class="submission-help">Add consistent catalogue images. Each image records where it came from and whether DiaperScout has permission to use it publicly.</p>

                    <div class="submission-image-grid">
                        @foreach (var role in imageRoles)
                        {
                            var roleImages = images.Where(image => image.Role == role).ToList();

                            <div class="submission-card submission-image-card">
                                <div class="submission-image-card-heading">
                                    <div>
                                        <strong>@ImageLabel(role)</strong>
                                        <small>@ImageRoleHelp(role)</small>
                                    </div>
                                    <span class="submission-image-status">
                                        @(roleImages.Count == 0 ? "Not added" : roleImages.Count == 1 ? "Added" : $"{roleImages.Count} added")
                                    </span>
                                </div>

                                @if (roleImages.Count > 0)
                                {
                                    @foreach (var image in roleImages)
                                    {
                                        <div class="submission-image-item">
                                            @if (imagePreviewDataUris.TryGetValue(image.Id, out var preview))
                                            {
                                                <img src="@preview" alt="@ImageLabel(role)" class="submission-image-preview" />
                                            }
                                            <div class="submission-image-meta">
                                                <strong>@image.OriginalFileName</strong>
                                                <small>@FormatFileSize(image.FileSizeBytes) · @FormatEnum(image.SourceType) · @FormatEnum(image.PermissionStatus)</small>
                                                @if (image.Visibility == CatalogueContentVisibility.ModeratorOnly)
                                                {
                                                    <small class="submission-image-warning">Moderator-only until publication rights are established.</small>
                                                }
                                            </div>
                                            <div class="submission-image-actions">
                                                <button class="ds-button ds-button-secondary" type="button" @onclick="() => BeginEditImage(image)">Edit rights</button>
                                                <button class="ds-button ds-button-secondary" type="button" @onclick="() => RemoveImageAsync(image)">Remove</button>
                                            </div>
                                        </div>
                                    }
                                }

                                @if (activeImageRole == role)
                                {
                                    <div class="submission-image-editor">
                                        <div class="submission-field submission-field-wide">
                                            <label>Image file</label>
                                            <InputFile @key="imageInputKey" OnChange="HandleImageSelectedAsync" accept="image/jpeg,image/png,image/webp" />
                                            <small>JPEG, PNG or WebP · maximum 15 MB</small>
                                            @if (selectedImageFile is not null)
                                            {
                                                <small>Selected: @selectedImageFile.Name (@FormatFileSize(selectedImageFile.Size))</small>
                                            }
                                        </div>
                                        <div class="submission-grid">
                                            <div class="submission-field">
                                                <label>Source</label>
                                                <InputSelect class="ds-select" @bind-Value="imageEditor.SourceType">
                                                    @foreach (var value in Enum.GetValues<CatalogueImageSourceType>())
                                                    {
                                                        <option value="@value">@FormatEnum(value)</option>
                                                    }
                                                </InputSelect>
                                            </div>
                                            <div class="submission-field">
                                                <label>Permission</label>
                                                <InputSelect class="ds-select" @bind-Value="imageEditor.PermissionStatus">
                                                    @foreach (var value in Enum.GetValues<CatalogueImagePermissionStatus>())
                                                    {
                                                        <option value="@value">@FormatEnum(value)</option>
                                                    }
                                                </InputSelect>
                                            </div>
                                            <div class="submission-field submission-field-wide">
                                                <label>Source URL</label>
                                                <InputText class="ds-input" @bind-Value="imageEditor.SourceUrl" placeholder="https://…" />
                                            </div>
                                            <div class="submission-field submission-field-wide">
                                                <label>Source / permission notes</label>
                                                <InputTextArea class="ds-textarea" @bind-Value="imageEditor.SourceNotes" placeholder="Where did the image come from? Add any useful context." />
                                            </div>
                                            <div class="submission-field submission-field-wide">
                                                <label>Permission evidence</label>
                                                <InputTextArea class="ds-textarea" @bind-Value="imageEditor.PermissionEvidence" placeholder="How was permission established, or why is permission not required?" />
                                            </div>
                                        </div>
                                        <div class="submission-actions">
                                            <button class="ds-button ds-button-secondary" type="button" @onclick="CancelImageEdit">Cancel</button>
                                            <button class="ds-button ds-button-primary" type="button" disabled="@imageSaving" @onclick="SaveImageAsync">Save image</button>
                                        </div>
                                    </div>
                                }
                                else if (role != CatalogueSubmissionImageRole.Other || roleImages.Count == 0)
                                {
                                    <button class="ds-button ds-button-secondary" type="button" @onclick="() => BeginAddImage(role)">@(roleImages.Count == 0 ? "Add image" : "Replace image")</button>
                                }
                                else
                                {
                                    <button class="ds-button ds-button-secondary" type="button" @onclick="() => BeginAddImage(role)">Add another image</button>
                                }
                            </div>
                        }
                    </div>

                    <div class="submission-next">
                        <div><p class="catalogue-kicker">NEXT</p><h2>Verification</h2><p>Review the catalogue entry and the evidence supporting it.</p></div>
                        <button class="ds-button ds-button-primary" type="button" @onclick="BeginVerificationAsync">Continue →</button>
                    </div>
                </section>
            }
            else
            {
                <section class="submission-panel">
                    <div class="submission-panel-heading"><div><p class="catalogue-kicker">STEP 6 OF 6</p><h2>Verification</h2></div></div>
                    <p class="submission-help">Review the product before it becomes catalogue-ready. Verification confirms that the product and its information are supported by sufficient trustworthy evidence.</p>
                    @foreach (var area in requiredVerificationAreas)
                    {
                        var verification = GetVerification(area);

                        <div class="submission-card">
                            <div>
                                <strong>@(verification is not null ? "✓" : "○") @FormatVerificationArea(area)</strong>
                                <small>@VerificationScope(area)</small>
                                @if (verification is not null)
                                {
                                    <small>Source: @verification.Source</small>
                                }
                            </div>
                            @if (verification is null && submission.Status == CatalogueSubmissionStatus.InVerification)
                            {
                                <button class="ds-button ds-button-secondary" type="button" @onclick="() => BeginVerificationReview(area)" disabled="@saving">Verify</button>
                            }
                            else if (verification is not null)
                            {
                                <span class="submission-status">@FormatEnum(verification.Status)</span>
                            }
                        </div>

                        @if (verificationEditorArea == area)
                        {
                            <div class="submission-card submission-card-rights">
                                <div class="submission-field submission-field-wide">
                                    <label>Verification source</label>
                                    <InputSelect class="ds-select" @bind-Value="verificationEditorSource">
                                        <option value="">Select the evidence source…</option>
                                        @foreach (var source in verificationSourceOptions)
                                        {
                                            <option value="@source">@source</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="submission-field submission-field-wide">
                                    <label>Source URL <span>(optional)</span></label>
                                    <InputText class="ds-input" @bind-Value="verificationEditorSourceUrl" />
                                </div>
                                <div class="submission-field submission-field-wide">
                                    <label>Verification notes <span>(optional)</span></label>
                                    <InputTextArea class="ds-textarea" @bind-Value="verificationEditorNotes" />
                                </div>
                                <div class="submission-actions">
                                    <button class="ds-button ds-button-secondary" type="button" @onclick="CancelVerificationReview">Cancel</button>
                                    <button class="ds-button ds-button-primary" type="button" @onclick="SaveVerificationAsync" disabled="@saving">Save verification</button>
                                </div>
                            </div>
                        }
                    }
                    <div class="submission-card submission-card-entities">
                        <div>
                            <strong>Catalogue entities</strong>
                            <small>Resolve the proposed business and brand to canonical catalogue entities before publication. You can match an existing entity or explicitly create a new one.</small>
                        </div>

                        <div class="submission-grid">
                            <div class="submission-field submission-field-wide">
                                <label>Business / manufacturer</label>
                                <div class="submission-choice-row" role="radiogroup" aria-label="Manufacturer resolution method">
                                    <label class="submission-choice">
                                        <input type="radio" name="entity-manufacturer-mode" value="existing"
                                               checked="@(entityManufacturerMode == "existing")"
                                               @onchange="SetEntityManufacturerExisting" />
                                        <span>Match existing</span>
                                    </label>
                                    <label class="submission-choice">
                                        <input type="radio" name="entity-manufacturer-mode" value="new"
                                               checked="@(entityManufacturerMode == "new")"
                                               @onchange="SetEntityManufacturerNew" />
                                        <span>Create new</span>
                                    </label>
                                </div>

                                @if (entityManufacturerMode == "existing")
                                {
                                    <InputSelect class="ds-select"
                                                 @bind-Value="entityManufacturerId"
                                                 @bind-Value:after="EntityManufacturerChangedAsync">
                                        <option value="">Select a canonical business…</option>
                                        @foreach (var manufacturer in entryOptions?.Manufacturers.OrderBy(value => value.Name).ToList() ?? [])
                                        {
                                            <option value="@manufacturer.Id">@manufacturer.Name</option>
                                        }
                                    </InputSelect>
                                }
                                else
                                {
                                    <InputText class="ds-input" @bind-Value="entityNewManufacturerName"
                                               placeholder="New canonical business name…" />
                                }

                                <small>Proposed: <strong>@submission.ProposedManufacturerName</strong></small>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(submission.ProposedBrandName))
                            {
                                <div class="submission-field submission-field-wide">
                                    <label>Brand</label>
                                    <div class="submission-choice-row" role="radiogroup" aria-label="Brand resolution method">
                                        <label class="submission-choice">
                                            <input type="radio" name="entity-brand-mode" value="existing"
                                                   checked="@(entityBrandMode == "existing")"
                                                   @onchange="SetEntityBrandExisting"
                                                   disabled="@(entityManufacturerMode == "new")" />
                                            <span>Match existing</span>
                                        </label>
                                        <label class="submission-choice">
                                            <input type="radio" name="entity-brand-mode" value="new"
                                                   checked="@(entityBrandMode == "new")"
                                                   @onchange="SetEntityBrandNew" />
                                            <span>Create new</span>
                                        </label>
                                    </div>

                                    @if (entityManufacturerMode == "existing" && entityBrandMode == "existing")
                                    {
                                        <InputSelect class="ds-select" @bind-Value="entityBrandId">
                                            <option value="">Select a canonical brand…</option>
                                            @foreach (var brand in GetEntityBrands().OrderBy(value => value.Name))
                                            {
                                                <option value="@brand.Id">@brand.Name</option>
                                            }
                                        </InputSelect>
                                    }
                                    else
                                    {
                                        <InputText class="ds-input" @bind-Value="entityNewBrandName"
                                                   placeholder="New canonical brand name…" />
                                    }

                                    <small>Proposed: <strong>@submission.ProposedBrandName</strong></small>
                                </div>
                            }
                        </div>

                        <div class="submission-actions">
                            <button class="ds-button ds-button-secondary" type="button"
                                    @onclick="ResolveEntitiesAsync" disabled="@saving">
                                Save catalogue entities
                            </button>
                        </div>
                    </div>

                    <div class="submission-card submission-card-rights">
                        <div>
                            <strong>Content publication rights</strong>
                            <small>Moderator-only content remains visible here to authorised staff but is omitted from the public catalogue.</small>
                        </div>
                        <div class="submission-field">
                            <label>Description visibility</label>
                            <InputSelect class="ds-input" @bind-Value="detailsModel.DescriptionVisibility">
                                @foreach (var value in Enum.GetValues<CatalogueContentVisibility>())
                                {
                                    <option value="@value">@FormatEnum(value)</option>
                                }
                            </InputSelect>
                        </div>
                        <button class="ds-button ds-button-secondary" type="button" @onclick="SaveDescriptionVisibilityAsync" disabled="@saving">Save rights setting</button>
                    </div>
                    <div class="submission-card">
                        @if (images.Count == 0)
                        {
                            <strong>⚠ Images &amp; rights</strong>
                            <small>No catalogue images have been added yet.</small>
                        }
                        else if (ImageRightsReady)
                        {
                            <strong>✓ Images &amp; rights</strong>
                            <small>@images.Count image@(images.Count == 1 ? "" : "s") added; every uploaded image has a known source and usable permission status.</small>
                        }
                        else
                        {
                            <strong>✓ Images &amp; rights</strong>
                            <small>@images.Count image@(images.Count == 1 ? "" : "s") added. Any uncleared images will remain moderator-only until their rights are established.</small>
                        }
                    </div>
                    <div class="submission-next">
                         <div>
                             <p class="catalogue-kicker">CATALOGUE READY</p>
                             <h2>What would you like to do?</h2>
                             <p>The product has completed the creation workflow. Retail and Affiliate can be handled separately.</p>
                         </div>
                         <div class="submission-actions">
                             @if (submission.Status == CatalogueSubmissionStatus.Approved)
                             {
                                 <button class="ds-button ds-button-secondary" type="button" @onclick="ReturnToVerificationAsync" disabled="@saving">Return to verification</button>
                             }
                             <button class="ds-button ds-button-secondary" type="button">Save unpublished</button>
                             <button class="ds-button ds-button-primary" type="button" @onclick="PublishNowAsync" disabled="@saving">@(saving ? "Publishing…" : submission.Status == CatalogueSubmissionStatus.Approved ? "Publish →" : "Approve & publish →")</button>
                         </div>
                     </div>
                </section>
            }
        }
    </div>
</section>

@code {
    private CreateModel createModel = new();
    private DetailsModel detailsModel = new();
    private CatalogueSubmissionReceipt? submission;
    private IReadOnlyList<CatalogueSubmissionVariantReceipt> variants = [];
    private CatalogueSubmissionVariantReceipt? editingVariant;
    private string variantEditorName = "";
    private bool addingVariant;
    private bool addingBaseVariant;
    private Guid? variantCopySourceId;
    private bool variantsLoading;
    private readonly Dictionary<Guid, CatalogueSubmissionVariantOverrideReceipt?> variantOverrides = [];
    private readonly VariantEditorModel variantEditor = new();

    private readonly Dictionary<Guid, IReadOnlyList<CatalogueSubmissionSizeVariantReceipt>> sizeVariants = [];
    private Guid? editingSizeVariantId;
    private Guid? editingSizeId;
    private readonly SizeEditorModel sizeEditor = new();

    private bool saving;
    private bool accessDenied;
    private string? saveError;
    private string? saveMessage;
    [Parameter] public Guid? submissionId { get; set; }
    [Parameter] public int? step { get; set; }
    [SupplyParameterFromQuery(Name = "maxStep")] private int? maxStep { get; set; }

    private int currentStep = 1;
    private int maxReachedStep = 1;
    private string manufacturerMode = "existing";
    private string brandMode = "existing";

    private CatalogueEntryOptions? entryOptions;
    private Guid? entityManufacturerId;
    private Guid? entityBrandId;
    private string entityManufacturerMode = "existing";
    private string entityBrandMode = "existing";
    private string? entityNewManufacturerName;
    private string? entityNewBrandName;

    private static readonly CatalogueSubmissionImageRole[] imageRoles =
    [
        CatalogueSubmissionImageRole.PackFront,
        CatalogueSubmissionImageRole.PackBack,
        CatalogueSubmissionImageRole.ProductFront,
        CatalogueSubmissionImageRole.ProductRear,
        CatalogueSubmissionImageRole.ProductInterior,
        CatalogueSubmissionImageRole.ProductDetail,
        CatalogueSubmissionImageRole.SizeMeasurement,
        CatalogueSubmissionImageRole.Other
    ];

    private IReadOnlyList<CatalogueSubmissionImageReceipt> images = [];
    private readonly Dictionary<Guid, string> imagePreviewDataUris = [];
    private CatalogueSubmissionVerificationWorkspace? verificationWorkspace;
    private CatalogueVerificationArea? verificationEditorArea;
    private string verificationEditorSource = "";
    private string? verificationEditorSourceUrl;
    private string? verificationEditorNotes;

    private static readonly CatalogueVerificationArea[] requiredVerificationAreas =
    [
        CatalogueVerificationArea.ProductIdentity,
        CatalogueVerificationArea.Specifications
    ];

    private static readonly string[] verificationSourceOptions =
    [
        "Manufacturer website",
        "Manufacturer product documentation",
        "Product packaging / label",
        "Retailer website",
        "Retailer product documentation",
        "Physical product inspection",
        "User/community supplied evidence",
        "Other"
    ];

    private CatalogueSubmissionImageRole? activeImageRole;
    private Guid? editingImageId;
    private IBrowserFile? selectedImageFile;
    private int imageInputKey;
    private bool imageSaving;
    private readonly ImageEditorModel imageEditor = new();

    protected override async Task OnParametersSetAsync()
    {
        if (submissionId is null)
        {
            currentStep = 1;
            return;
        }

        currentStep = Math.Clamp(step ?? 1, 1, 6);
        maxReachedStep = Math.Clamp(
            maxStep ?? currentStep,
            currentStep,
            6);

        var result = await Catalogue.GetSubmissionAsync(submissionId.Value);

        if (result.Receipt is not null)
        {
            Apply(result);

            createModel.ProposedManufacturerName =
                result.Receipt.ProposedManufacturerName;
            createModel.ProposedBrandName =
                result.Receipt.ProposedBrandName;
            createModel.ProposedProductName =
                result.Receipt.ProposedProductName;

            detailsModel.ProposedProductType =
                result.Receipt.ProposedProductType;
            detailsModel.ProductFamily =
                result.Receipt.ProposedProductFamily;
            detailsModel.Description =
                result.Receipt.ProposedDescription;
            detailsModel.DescriptionVisibility =
                result.Receipt.ProposedDescriptionVisibility;
            detailsModel.ProductStatus =
                result.Receipt.ProposedProductStatus;
            detailsModel.PackagingType =
                result.Receipt.ProposedPackagingType;
            detailsModel.OfficialWebsiteUrl =
                result.Receipt.ProposedOfficialWebsiteUrl;

            if (currentStep >= 2)
                await LoadVariantsAsync();

            if (currentStep >= 5)
                await LoadImagesAsync();

            if (currentStep >= 6)
                await LoadVerificationWorkspaceAsync();

            return;
        }

        accessDenied = result.Status == CatalogueSubmissionResultStatus.AccessDenied;
        saveError = result.Message ?? "The catalogue submission could not be loaded.";
    }

    private async Task LoadImagesAsync()
    {
        if (submission is null)
            return;

        var result = await Catalogue.GetSubmissionImagesAsync(submission.Id);

        if (result.Status != CatalogueSubmissionImagesResultStatus.Found)
        {
            images = [];
            return;
        }

        images = result.Images ?? [];
        imagePreviewDataUris.Clear();

        foreach (var image in images)
        {
            var preview = await Catalogue.GetSubmissionImageDataUriAsync(
                submission.Id,
                image.Id,
                image.ContentType);

            if (preview is not null)
                imagePreviewDataUris[image.Id] = preview;
        }
    }

    private async Task LoadVerificationWorkspaceAsync()
    {
        if (submission is null)
            return;

        var result = await Catalogue.GetVerificationWorkspaceAsync(submission.Id);

        if (result.Status == CatalogueSubmissionVerificationWorkspaceStatus.Found)
            verificationWorkspace = result.Workspace;
        else
            verificationWorkspace = null;

        if (result.Status == CatalogueSubmissionVerificationWorkspaceStatus.AccessDenied)
        {
            accessDenied = true;
            return;
        }

        if (result.Status == CatalogueSubmissionVerificationWorkspaceStatus.Failed)
        {
            saveError = result.Message ?? "The verification workspace could not be loaded.";
            return;
        }

        await LoadEntityOptionsAsync();
    }

    private async Task LoadEntityOptionsAsync()
    {
        if (submission is null)
            return;

        var result = await Catalogue.GetEntryOptionsAsync();

        if (result.Status == CatalogueEntryOptionsStatus.AccessDenied)
        {
            accessDenied = true;
            return;
        }

        if (result.Status != CatalogueEntryOptionsStatus.Found || result.Options is null)
        {
            entryOptions = null;
            saveError = result.Message ?? "The catalogue entity options could not be loaded.";
            return;
        }

        entryOptions = result.Options;

        var manufacturer = entryOptions.Manufacturers.FirstOrDefault(value =>
            string.Equals(value.Name, submission.ProposedManufacturerName, StringComparison.OrdinalIgnoreCase));

        entityManufacturerId = manufacturer?.Id;
        entityManufacturerMode = manufacturer is not null ? "existing" : "new";
        entityNewManufacturerName = manufacturer is null ? submission.ProposedManufacturerName : null;

        entityBrandId = null;
        entityBrandMode = "new";
        entityNewBrandName = submission.ProposedBrandName;

        if (manufacturer is not null && !string.IsNullOrWhiteSpace(submission.ProposedBrandName))
        {
            var brand = entryOptions.Brands.FirstOrDefault(value =>
                value.ManufacturerId == manufacturer.Id &&
                string.Equals(value.Name, submission.ProposedBrandName, StringComparison.OrdinalIgnoreCase));

            if (brand is not null)
            {
                entityBrandId = brand.Id;
                entityBrandMode = "existing";
                entityNewBrandName = null;
            }
        }
    }

    private IEnumerable<CatalogueBrandOption> GetEntityBrands() =>
        entryOptions is null || entityManufacturerId is null
            ? []
            : entryOptions.Brands.Where(value => value.ManufacturerId == entityManufacturerId.Value);

    private void SetEntityManufacturerExisting(ChangeEventArgs _)
    {
        entityManufacturerMode = "existing";
        entityNewManufacturerName = null;
        entityManufacturerId = null;
        entityBrandId = null;

        var manufacturer = entryOptions?.Manufacturers.FirstOrDefault(value =>
            string.Equals(value.Name, submission?.ProposedManufacturerName, StringComparison.OrdinalIgnoreCase));

        if (manufacturer is not null)
        {
            entityManufacturerId = manufacturer.Id;
            SyncEntityBrandForManufacturer(manufacturer.Id);
        }
        else
        {
            entityBrandMode = "new";
            entityNewBrandName = submission?.ProposedBrandName;
        }
    }

    private Task EntityManufacturerChangedAsync()
    {
        entityBrandId = null;

        if (entityManufacturerId is Guid manufacturerId)
            SyncEntityBrandForManufacturer(manufacturerId);
        else
        {
            entityBrandMode = "new";
            entityNewBrandName = submission?.ProposedBrandName;
        }

        return Task.CompletedTask;
    }

    private void SetEntityManufacturerNew(ChangeEventArgs _)
    {
        entityManufacturerMode = "new";
        entityManufacturerId = null;
        entityBrandId = null;
        entityNewManufacturerName = submission?.ProposedManufacturerName;
        entityBrandMode = "new";
        entityNewBrandName = submission?.ProposedBrandName;
    }

    private void SetEntityBrandExisting(ChangeEventArgs _)
    {
        entityBrandMode = "existing";
        entityNewBrandName = null;

        if (entityManufacturerId is null)
        {
            entityBrandId = null;
            return;
        }

        entityBrandId = GetEntityBrands()
            .FirstOrDefault(value =>
                string.Equals(value.Name, submission?.ProposedBrandName, StringComparison.OrdinalIgnoreCase))
            ?.Id;
    }

    private void SetEntityBrandNew(ChangeEventArgs _)
    {
        entityBrandMode = "new";
        entityBrandId = null;
        entityNewBrandName = submission?.ProposedBrandName;
    }

    private void SyncEntityBrandForManufacturer(Guid manufacturerId)
    {
        if (string.IsNullOrWhiteSpace(submission?.ProposedBrandName))
        {
            entityBrandId = null;
            entityBrandMode = "new";
            entityNewBrandName = null;
            return;
        }

        var brand = entryOptions?.Brands.FirstOrDefault(value =>
            value.ManufacturerId == manufacturerId &&
            string.Equals(value.Name, submission.ProposedBrandName, StringComparison.OrdinalIgnoreCase));

        if (brand is not null)
        {
            entityBrandId = brand.Id;
            entityBrandMode = "existing";
            entityNewBrandName = null;
        }
        else
        {
            entityBrandId = null;
            entityBrandMode = "new";
            entityNewBrandName = submission.ProposedBrandName;
        }
    }

    private async Task ResolveEntitiesAsync()
    {
        if (submission is null)
            return;

        saving = true;
        saveError = null;
        saveMessage = null;
        accessDenied = false;

        var result = await Catalogue.ResolveSubmissionEntitiesAsync(
            submission.Id,
            new ResolveCatalogueSubmissionEntitiesRequest(
                entityManufacturerMode == "existing" ? entityManufacturerId : null,
                entityManufacturerMode == "new" ? entityNewManufacturerName : null,
                entityBrandMode == "existing" ? entityBrandId : null,
                entityBrandMode == "new" ? entityNewBrandName : null));

        Apply(result);

        if (result.Status == CatalogueSubmissionResultStatus.Saved)
        {
            await LoadEntityOptionsAsync();
            saveMessage = "Catalogue entities resolved.";
        }

        saving = false;
    }

    private CatalogueSubmissionVerificationReceipt? GetVerification(
        CatalogueVerificationArea area) =>
        verificationWorkspace?.Verifications
            .Where(value =>
                value.Area == area &&
                value.Status is CatalogueVerificationStatus.Verified or CatalogueVerificationStatus.Inherited)
            .OrderByDescending(value => value.VerifiedAtUtc)
            .FirstOrDefault();

    private static string FormatVerificationArea(CatalogueVerificationArea area) =>
        area switch
        {
            CatalogueVerificationArea.ProductIdentity => "Product identity",
            CatalogueVerificationArea.Specifications => "Product specifications",
            CatalogueVerificationArea.ContentAndRights => "Content & rights",
            CatalogueVerificationArea.Retail => "Retail information",
            _ => FormatEnum(area)
        };

    private static string VerificationScope(CatalogueVerificationArea area) =>
        area switch
        {
            CatalogueVerificationArea.ProductIdentity => "Manufacturer, brand and product name reviewed",
            CatalogueVerificationArea.Specifications => "Variants and size information reviewed",
            CatalogueVerificationArea.ContentAndRights => "Descriptions, images and publication rights reviewed",
            CatalogueVerificationArea.Retail => "Retail destinations and listing information reviewed",
            _ => "Catalogue information reviewed"
        };

    private void BeginVerificationReview(CatalogueVerificationArea area)
    {
        verificationEditorArea = area;
        verificationEditorSource = "";
        verificationEditorSourceUrl =
            area == CatalogueVerificationArea.ProductIdentity
                ? submission?.IdentitySourceUrl
                : null;
        verificationEditorNotes = null;
