    private static string FormatSizeSummary(
        CatalogueSubmissionSizeVariantReceipt size)
    {
        var parts = new List<string>();

        if (size.WaistMinimumCm.HasValue || size.WaistMaximumCm.HasValue)
            parts.Add($"Waist {FormatRange(size.WaistMinimumCm, size.WaistMaximumCm)} cm");

        if (size.HipMinimumCm.HasValue || size.HipMaximumCm.HasValue)
            parts.Add($"Hip {FormatRange(size.HipMinimumCm, size.HipMaximumCm)} cm");

        if (size.ManufacturerPackQuantity.HasValue)
            parts.Add($"Pack {size.ManufacturerPackQuantity.Value}");

        if (!string.IsNullOrWhiteSpace(size.Gtin))
            parts.Add($"GTIN {size.Gtin}");

        return parts.Count == 0 ? "No optional size information supplied" : string.Join(" · ", parts);
    }

    private static string FormatRange(int? minimum, int? maximum) =>
        minimum.HasValue && maximum.HasValue
            ? $"{minimum}–{maximum}"
            : minimum?.ToString() ?? maximum?.ToString() ?? "unknown";

