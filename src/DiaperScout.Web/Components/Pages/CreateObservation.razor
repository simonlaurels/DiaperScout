@page "/observations/new"
@page "/contribute/product/discovery"
@rendermode InteractiveServer
@inject PlaceObservationClient PlacesClient
@inject AuthenticationStateProvider Authentication
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>Create observation · DiaperScout</PageTitle>
<main class="contribution-page discovery-flow">
    <a class="scan-back" href="/scan" aria-label="Back to Scan">‹</a>
    @if (!pwa || (saved is null && !pendingSaved)) { <p class="catalogue-kicker">A real place, a moment in time</p><h1>@(pwa ? step == 1 ? "Where did you find it?" : step == 2 ? "Add discovery details" : "Review your discovery" : "Record where you found it")</h1> }
    @if (loading) { <p role="status">Checking this exact pack…</p> }
    else if (SubmissionId.HasValue && !authenticated) { <p>Sign in to preserve where you found your submitted product.</p><a href="@SignInUrl" class="ds-button ds-button-primary" data-enhance-nav="false">Sign in and continue</a> }
    else if (pack is null && pendingProposal is null) { <p role="alert">@(error ?? "This pack is no longer available. Scan another item to continue.")</p><a href="/scan" class="ds-button ds-button-primary">Scan another item</a> }
    else if (pendingSaved) { <section class="contribution-card discovery-completion"><h2>Discovery evidence saved</h2><p>We’ve kept where you found this product with your proposal. It will remain private until a moderator identifies its exact pack.</p><a href="/" class="ds-button ds-button-primary">Done</a></section> }
    else if (saved is not null) {
        <section class="contribution-card discovery-completion" role="status"><div class="discovery-artwork-slot" aria-hidden="true"><AppIcon Name="map" /></div><h2>@(pwa ? "Discovery recorded!" : "Observation saved")</h2><p>Your report records this pack at @selectedShop?.Name at @saved.ObservedAtUtc.ToString("d MMM yyyy, HH:mm 'UTC'"). It does not promise future stock.</p></section>
        <div class="contribution-actions"><a href="@($"/atlas?locationId={saved.LocationId}")" class="ds-button ds-button-primary">View in Atlas</a><a href="@ProductUrl" class="ds-button ds-button-secondary">View product</a><a href="/scan" class="ds-button ds-button-secondary">Scan another item</a></div>
    } else {
        @if (pack is not null) { <section class="contribution-card exact-pack"><h2>@pack.Product.Name</h2><p>@pack.VariantName · @pack.ManufacturerSize · Pack of @pack.QuantityPerPack</p><a href="@ProductUrl">View this exact product pack</a></section> }
        else { <section class="contribution-card"><h2>@pendingProposal?.ProductName</h2><p>Your submitted product · awaiting moderator identification</p></section> }
        @if (!authenticated) {
            <section class="contribution-card"><h2>Sign in to save an observation</h2><p>The exact pack is waiting for you. You won’t need to scan again.</p><a class="ds-button ds-button-primary" href="@SignInUrl" data-enhance-nav="false">Sign in and continue</a></section>
        } else {
            @if (error is not null) { <p role="alert" class="contribution-message">@error</p> }
            @if (!pwa || step == 1) {
            <section class="contribution-card"><h2>Where did you find it?</h2>
                @if (pwa) { <p>Use your location to find known DiaperScout shops nearby. We keep the shop you select, not your device position.</p><button class="ds-button ds-button-secondary" @onclick="NearbyAsync" disabled="@(busy || module is null || locationDenied)"><span class="scan-busy">@(busy ? "Searching nearby shops…" : "Find nearby shops")</span></button>
                    @if (locationMessage is not null) { <p role="status">@locationMessage</p> } }
                <div class="contribution-search"><label for="place-query">Search shops by name, town or postcode</label><input id="place-query" @bind="query" maxlength="150" /><button type="button" class="ds-button ds-button-secondary" @onclick="SearchAsync" disabled="@busy">Search shops</button></div>
                @if (searched && shops.Count == 0) { <p role="status">No matching shops yet. Add the specific physical shop below.</p> }
                <div class="place-options">@foreach (var shop in shops) { <button type="button" class="atlas-place-choice @(selectedShop?.Id == shop.Id ? "selected" : "")" @onclick="() => Choose(shop)"><strong>@shop.Name</strong><span>@shop.AddressLine1, @shop.Locality, @shop.Postcode</span><span>@PlaceCategoryPresentation.Label(shop.Category) @(distances.TryGetValue(shop.Id, out var metres) ? $"· {metres / 1000:0.0} km away" : "")</span></button> }</div>
                <button type="button" class="ds-button ds-button-secondary" @onclick="() => { creatingShop = !creatingShop; error = null; }">@(creatingShop ? "Cancel adding a shop" : "Add a physical shop")</button>
                @if (selectedShop is not null) { <p role="status"><strong>Selected:</strong> @selectedShop.Name · @selectedShop.AddressLine1, @selectedShop.Locality</p> }
            </section>
            @if (creatingShop) {
                <section class="contribution-card contribution-fields"><h2>Add the specific shop</h2><p>Use the branch’s public address. This information and the shop position will appear in Atlas.</p>
                    <label for="shop-name">Shop or branch name</label><input id="shop-name" @bind="shopName" @bind:after="PersistAsync" disabled="@busy" maxlength="200" autocomplete="organization" />
                    <label for="shop-address">Street address</label><input id="shop-address" @bind="address" @bind:after="PersistAsync" disabled="@busy" maxlength="250" autocomplete="off" />
                    <label for="shop-town">Town or city</label><input id="shop-town" @bind="town" @bind:after="PersistAsync" disabled="@busy" maxlength="150" autocomplete="off" />
                    <label for="shop-postcode">Postcode or postal code</label><input id="shop-postcode" @bind="postcode" @bind:after="PersistAsync" disabled="@busy" maxlength="32" autocomplete="off" />
                    <label for="shop-country">Country</label><select id="shop-country" @bind="country" @bind:after="PersistAsync" disabled="@busy">@foreach (var item in countries) { <option value="@item.Code">@item.Name</option> }</select>
                    <label for="shop-category">Place type (optional)</label><PlaceCategorySelect Id="shop-category" @bind-Value="shopCategory" @bind-Value:after="PersistAsync" />
                    <p>Zoom and tap the shop on the map, or enter its coordinates. The initial map centre is only a starting view; no shop position is chosen automatically.</p>
                    <PlaceMap PickPosition="true" PositionSelected="PositionSelected" />
                    <div class="contribution-columns"><div><label for="shop-latitude">Shop latitude</label><input id="shop-latitude" type="number" step="0.000001" min="-90" max="90" @bind="latitude" @bind:after="PersistAsync" disabled="@busy" /></div><div><label for="shop-longitude">Shop longitude</label><input id="shop-longitude" type="number" step="0.000001" min="-180" max="180" @bind="longitude" @bind:after="PersistAsync" disabled="@busy" /></div></div>
                    <label class="contribution-check"><input type="checkbox" @bind="confirmPublic" @bind:after="PersistAsync" disabled="@busy" />This is a public commercial shop, not a home or private place.</label>
                    <label class="contribution-check"><input type="checkbox" @bind="confirmPosition" @bind:after="PersistAsync" disabled="@busy" />The position is the shop itself. I understand it will be public.</label>
                    <button type="button" class="ds-button ds-button-secondary" @onclick="CreateShopAsync" disabled="@busy">@(busy ? "Saving shop…" : "Use this shop")</button>
                </section>
            }
            @if (pwa && selectedShop is not null && !creatingShop) { <button class="ds-button ds-button-primary" @onclick="() => StepAsync(2)">Continue</button> }
            }
            @if (!pwa || step == 2) {
            <section class="contribution-card contribution-fields"><h2>What did you observe?</h2>
                <label for="observed-at">Observed at (your local time)</label><input id="observed-at" type="datetime-local" value="@observedLocal" @onchange="async e => { observedLocal = e.Value?.ToString() ?? string.Empty; await PersistAsync(); }" disabled="@busy" />
                <div class="contribution-columns"><div><label for="observed-price">Price (optional)</label><input id="observed-price" type="number" step="0.01" min="0" @bind="price" @bind:after="PersistAsync" disabled="@busy" inputmode="decimal" /></div><div><label for="observed-currency">Currency</label><input id="observed-currency" @bind="currency" @bind:after="PersistAsync" disabled="@busy" maxlength="3" placeholder="GBP" /></div></div>
                <p>This saves a dated contributor report for this exact pack at this shop. Your account identity is retained privately for provenance.</p>
                @if (pwa) { <button class="ds-button ds-button-primary" @onclick="() => StepAsync(3)" disabled="@(busy || selectedShop is null || module is null)">Review discovery</button><button class="ds-button ds-button-secondary" @onclick="() => StepAsync(1)">Change shop</button> }
                else { <button type="button" class="ds-button ds-button-primary" @onclick="SaveAsync" disabled="@(busy || selectedShop is null || module is null)">@(busy ? "Saving…" : "Save observation")</button> }
                <a href="@SignInUrl" data-enhance-nav="false">Sign in again if your session has expired</a>
            </section>
            }
            @if (pwa && step == 3) {
                <section class="discovery-review"><div><p><strong>@selectedShop?.Name</strong><br />@selectedShop?.AddressLine1, @selectedShop?.Locality</p><button @onclick="() => StepAsync(1)">Edit</button></div>
                    <div><p>Physically found at this shop</p></div><div><p>@(price.HasValue ? $"{price:0.00} {currency}" : "No shelf price supplied")</p><button @onclick="() => StepAsync(2)">Edit</button></div><div><p>@observedLocal.Replace('T', ' ')</p><button @onclick="() => StepAsync(2)">Edit</button></div></section>
                <p>Discoveries record what someone found at a particular time. They do not guarantee current stock.</p>
                <button class="ds-button ds-button-primary" @onclick="SaveAsync" disabled="@busy"><span class="scan-busy">@(busy ? "Recording…" : "Record discovery")</span></button>
            }
        }
    }
</main>
@code {
    [SupplyParameterFromQuery(Name="packTypeId")] public Guid? PackTypeId { get; set; }
    [SupplyParameterFromQuery(Name="submissionId")] public Guid? SubmissionId { get; set; }
    private PublicProposalIdentity? pendingProposal;
    private bool pendingSaved, locationDenied;
    private string? locationMessage;
    private Dictionary<Guid,double> distances = [];
    private string DraftKey => "discovery-" + (SubmissionId ?? PackTypeId);
    private ProductIdentification? pack;
    private PhysicalObservationReceipt? saved;
    private IReadOnlyList<PlaceItem> shops = [];
    private IReadOnlyList<PlaceCountry> countries = [];
    private PlaceItem? selectedShop;
    private bool loading = true, authenticated, busy, creatingShop, searched, confirmPublic, confirmPosition;
    private string? error;
    private string query = "", shopName = "", address = "", town = "", postcode = "", country = "GB", currency = "GBP", observedLocal = "";
    private decimal? latitude, longitude, price;
    private PlaceCategory? shopCategory;
    private Guid contributionId = Guid.NewGuid();
    private bool pwa;
    private int step = 1;
    private string? draftOwner;
    private IJSObjectReference? module;
    private string ProductUrl => pack is null ? "/scan" : PublicProductIdentity.ProductUrl(pack.Product.Slug, pack.ProductVariantId) + "&packTypeId=" + pack.PackTypeId;
    private string SignInUrl => "/signin?returnUrl=" + Uri.EscapeDataString(SubmissionId.HasValue ? "/contribute/product/discovery?submissionId=" + SubmissionId : "/observations/new?packTypeId=" + PackTypeId);
    protected override async Task OnInitializedAsync() {
        var actor = (await Authentication.GetAuthenticationStateAsync()).User;
        authenticated = actor.Identity?.IsAuthenticated == true;
        draftOwner = actor.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        try { if (SubmissionId.HasValue && authenticated) pendingProposal = await PlacesClient.ProposalIdentityAsync(SubmissionId.Value); else if (PackTypeId.HasValue) pack = await PlacesClient.PackAsync(PackTypeId.Value); if (authenticated) countries = await PlacesClient.CountriesAsync(); }
        catch (ContributionException e) { error = e.Message; }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException) { error = "We couldn’t load this pack. Check your connection, then return to Scan and try again."; }
        loading = false;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;
        try { module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/contribution-draft.js"); pwa = await module.InvokeAsync<bool>("isInstalled"); observedLocal = await module.InvokeAsync<string>("localNow");
            if (authenticated && (PackTypeId.HasValue || SubmissionId.HasValue) && await module.InvokeAsync<DiscoveryDraft?>("loadDraft", DraftKey, draftOwner) is { } draft && draft.ContributionId != Guid.Empty) {
                selectedShop = draft.Shop; observedLocal = draft.ObservedLocal; price = draft.Price; currency = draft.Currency; contributionId = draft.ContributionId; step = draft.Step;
                shopName = draft.ShopName ?? ""; address = draft.Address ?? ""; town = draft.Town ?? ""; postcode = draft.Postcode ?? "";
                country = draft.Country ?? "GB"; shopCategory = draft.Category; latitude = draft.Latitude; longitude = draft.Longitude;
                confirmPublic = draft.ConfirmPublic; confirmPosition = draft.ConfirmPosition; creatingShop = draft.CreatingShop;
            }
            StateHasChanged(); }
        catch (Exception e) when (e is JSException or JSDisconnectedException) { error = "We couldn’t initialise the observation time. Reload when connected to continue."; StateHasChanged(); }
    }
    private async Task SearchAsync() => await Act(async () => { shops = await PlacesClient.SearchAsync(query); searched = true; });
    private async Task Choose(PlaceItem shop) { selectedShop = shop; creatingShop = false; await PersistAsync(); }
    private async Task StepAsync(int value) { step = value; await PersistAsync(); }
    private async Task PersistAsync() {
        if (module is not null && authenticated && (PackTypeId.HasValue || SubmissionId.HasValue) && !await module.InvokeAsync<bool>("saveDraft", DraftKey, new DiscoveryDraft(selectedShop, observedLocal, price, currency, contributionId, step, shopName, address, town, postcode, country, shopCategory, latitude, longitude, confirmPublic, confirmPosition, creatingShop), draftOwner, step))
            error = "This browser could not keep a recovery copy. Keep this page open to retain your discovery.";
    }
    private sealed record DiscoveryDraft(PlaceItem? Shop, string ObservedLocal, decimal? Price, string Currency, Guid ContributionId, int Step,
        string? ShopName = null, string? Address = null, string? Town = null, string? Postcode = null, string? Country = null,
        PlaceCategory? Category = null, decimal? Latitude = null, decimal? Longitude = null, bool ConfirmPublic = false, bool ConfirmPosition = false, bool CreatingShop = false);
    private async Task PositionSelected(PlaceMap.PlacePosition point) { latitude = point.Latitude; longitude = point.Longitude; confirmPosition = false; await PersistAsync(); }
    private async Task CreateShopAsync() => await Act(async () => { selectedShop = await PlacesClient.CreateShopAsync(new(shopName, address, town, postcode, country, latitude, longitude, confirmPublic, confirmPosition, shopCategory)); creatingShop = false; await PersistAsync(); });
    private async Task SaveAsync() => await Act(async () => {
        if (selectedShop is null || (pack is null && pendingProposal is null) || module is null) return;
        var iso = await module.InvokeAsync<string>("toUtc", observedLocal);
        if (!DateTimeOffset.TryParse(iso, out var observed)) throw new ContributionException("Choose when you observed the pack.");
        if (SubmissionId.HasValue) { await PlacesClient.AttachDiscoveryAsync(SubmissionId.Value, new(selectedShop.Id, observed, price, currency)); pendingSaved = true; }
        else saved = await PlacesClient.ObserveAsync(new(pack!.PackTypeId, selectedShop.Id, observed, price, currency, contributionId));
        await module.InvokeVoidAsync("clearDraft", DraftKey, contributionId);
    });
    private async Task NearbyAsync() => await Act(async () => {
        if (module is null) return;
        var position = await module.InvokeAsync<NearbyPosition>("nearbyPosition");
        if (position.Status != "found") { locationDenied = position.Status == "denied"; locationMessage = "Location isn’t available. Search by shop name, town or postcode, or add the shop below."; return; }
        var nearby = await PlacesClient.NearbyAsync(new(position.Latitude, position.Longitude)); shops = nearby.Select(p => p.Place).ToArray(); distances = nearby.ToDictionary(p => p.Place.Id, p => p.DistanceMetres); searched = true;
        locationMessage = shops.Count == 0 ? "No known DiaperScout shops nearby yet. Search or add the shop below." : "Nearby known DiaperScout shops. Select the branch where you found it.";
    });
    private sealed record NearbyPosition(string Status, decimal Latitude, decimal Longitude);
    private async Task Act(Func<Task> action) {
        if (busy) return; busy = true; error = null;
        try { await PersistAsync(); await action(); } catch (ContributionException e) { error = e.Message; }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException or JSException) { error = "We couldn’t complete that action. Your entered information is still here; check your connection and try again."; }
        finally { busy = false; }
    }
    public async ValueTask DisposeAsync() { try { if (module is not null) await module.DisposeAsync(); } catch (JSDisconnectedException) { } }
}
