@page "/admin/integrations/dataforseo"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Moderator,Administrator")]
@rendermode InteractiveServer
@using DiaperScout.Application
@using DiaperScout.Web.Services
@inject DataForSeoIntegrationClient Integration

<PageTitle>DataForSEO · Integrations · DiaperScout</PageTitle>

<section class="integration-page">
    <div class="integration-container">
        <header class="integration-header">
            <div>
                <a class="integration-back" href="/admin">← Admin</a>
                <p class="admin-kicker">INTEGRATIONS</p>
                <h1>DataForSEO</h1>
                <p class="integration-intro">
                    Connect DiaperScout to merchant and shopping data so Scout can keep retailer prices and availability fresh.
                </p>
            </div>
            <div class="integration-mark" aria-hidden="true">✦</div>
        </header>

        @if (accessDenied)
        {
            <div class="integration-message integration-message-error" role="alert">
                <strong>Integration settings unavailable</strong>
                <p>You need Moderator or Administrator access to manage integrations.</p>
            </div>
        }
        else if (loadError)
        {
            <div class="integration-message integration-message-error" role="alert">
                <strong>Couldn't load DataForSEO</strong>
                <p>Try refreshing the page. If the problem persists, check that the API is available.</p>
            </div>
        }
        else if (settings is null)
        {
            <section class="integration-panel integration-loading">
                <strong>Loading integration settings…</strong>
                <span>Checking Scout's connection cupboard.</span>
            </section>
        }
        else
        {
            <section class="integration-panel">
                <div class="integration-panel-heading">
                    <div>
                        <p class="admin-kicker">MARKET DATA PROVIDER</p>
                        <h2>Connection</h2>
                        <p>Credentials are stored protected by DiaperScout and are never shown back in the browser.</p>
                    </div>
                    <span class="integration-status @(settings.Enabled && settings.HasPassword ? "is-ready" : "is-neutral")">
                        @(settings.Enabled && settings.HasPassword ? "Configured" : "Not configured")
                    </span>
                </div>

                <EditForm Model="model" OnValidSubmit="SaveAsync">
                    <div class="integration-grid">
                        <div class="integration-field integration-field-wide">
                            <label for="dfs-login">API login</label>
                            <InputText id="dfs-login" class="ds-input" @bind-Value="model.Login" autocomplete="username" />
                            <small>Use the API login from DataForSEO's API Access page.</small>
                        </div>

                        <div class="integration-field integration-field-wide">
                            <label for="dfs-password">API password</label>
                            <InputText id="dfs-password" type="password" class="ds-input" @bind-Value="model.Password" autocomplete="new-password" placeholder="@(settings.HasPassword ? "Leave blank to keep the stored password" : "Enter API password")" />
                            <small>@(settings.HasPassword ? "A blank password keeps the existing protected credential." : "The password is required when the integration is enabled.")</small>
                        </div>

                        <div class="integration-field">
                            <label for="dfs-location">Market</label>
                            <InputText id="dfs-location" class="ds-input" @bind-Value="model.LocationName" />
                        </div>

                        <div class="integration-field">
                            <label for="dfs-language">Language</label>
                            <InputText id="dfs-language" class="ds-input" @bind-Value="model.LanguageCode" />
                        </div>

                        <div class="integration-field">
                            <label for="dfs-domain">Search domain</label>
                            <InputText id="dfs-domain" class="ds-input" @bind-Value="model.SearchDomain" />
                        </div>

                        <label class="integration-toggle">
                            <InputCheckbox @bind-Value="model.Enabled" />
                            <span>
                                <strong>Enable DataForSEO</strong>
                                <small>Allow discovery and monitoring services to use this provider.</small>
                            </span>
                        </label>
                    </div>

                    @if (saveErrors.Count > 0)
                    {
                        <div class="integration-message integration-message-error" role="alert">
                            <strong>Check the settings</strong>
                            <ul>
                                @foreach (var error in saveErrors.Values.SelectMany(values => values))
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (saveMessage is not null)
                    {
                        <div class="integration-message integration-message-success" role="status">@saveMessage</div>
                    }

                    <div class="integration-actions">
                        <button class="ds-button ds-button-primary" type="submit" disabled="@saving">
                            @(saving ? "Saving…" : "Save settings")
                        </button>
                        <button class="ds-button ds-button-secondary" type="button" @onclick="TestConnectionAsync" disabled="@testing">
                            @(testing ? "Testing…" : "Test connection")
                        </button>
                    </div>
                </EditForm>
            </section>

            @if (testResult is not null)
            {
                <section class="integration-result @(testResult.Success ? "is-success" : "is-error")" role="status">
                    <span class="integration-result-icon" aria-hidden="true">@(testResult.Success ? "✓" : "!")</span>
                    <div>
                        <strong>@(testResult.Success ? "Connection successful" : "Connection not confirmed")</strong>
                        <p>@testResult.Message</p>
                    </div>
                </section>
            }

            <section class="integration-note">
                <strong>Scout's advice</strong>
                <span>Save the connection first, then test it. We won't start monitoring listings just because the provider is configured.</span>
            </section>
        }
    </div>
</section>

@code {
    private DataForSeoIntegrationSettings? settings;
    private DataForSeoForm model = new();
    private Dictionary<string, string[]> saveErrors = new();
    private DataForSeoConnectionTestResult? testResult;
    private string? saveMessage;
    private bool accessDenied;
    private bool loadError;
    private bool saving;
    private bool testing;

    protected override async Task OnInitializedAsync()
    {
        var result = await Integration.GetAsync();
        accessDenied = result.AccessDenied;
        loadError = !result.Success && !result.AccessDenied;

        if (result.Settings is not null)
        {
            settings = result.Settings;
            model = DataForSeoForm.From(settings);
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        saveErrors = new();
        saveMessage = null;
        testResult = null;

        try
        {
            var result = await Integration.SaveAsync(
                new(
                    model.Enabled,
                    model.Login,
                    string.IsNullOrWhiteSpace(model.Password) ? null : model.Password,
                    model.LocationName,
                    model.LanguageCode,
                    model.SearchDomain));

            if (result.AccessDenied)
            {
                accessDenied = true;
                return;
            }

            if (result.Errors.Count > 0)
            {
                saveErrors = new(result.Errors);
                return;
            }

            if (result.Settings is not null)
            {
                settings = result.Settings;
                model = DataForSeoForm.From(settings);
                saveMessage = "DataForSEO settings saved.";
            }
        }
        finally
        {
            saving = false;
        }
    }

    private async Task TestConnectionAsync()
    {
        testing = true;
        testResult = null;

        try
        {
            testResult = await Integration.TestConnectionAsync();
        }
        finally
        {
            testing = false;
        }
    }

    private sealed class DataForSeoForm
    {
        public bool Enabled { get; set; }
        public string Login { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string LocationName { get; set; } = "United Kingdom";
        public string LanguageCode { get; set; } = "en";
        public string SearchDomain { get; set; } = "google.co.uk";

        public static DataForSeoForm From(DataForSeoIntegrationSettings settings) =>
            new()
            {
                Enabled = settings.Enabled,
                Login = settings.Login,
                LocationName = settings.LocationName,
                LanguageCode = settings.LanguageCode,
                SearchDomain = settings.SearchDomain
            };
    }
}
