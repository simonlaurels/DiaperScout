@page "/"

<PageTitle>DiaperScout</PageTitle>

<div class="diaperscout-home">
    <section class="hero">
        <p class="eyebrow">THE ABSORBENT PRODUCT EXPLORER</p>

        <h1>Welcome to DiaperScout</h1>

        <p class="hero-introduction">
            Explore absorbent products, discover what works for you,
            and share what you find with the Scout community.
        </p>

        <div class="hero-actions">
            <a class="ds-button ds-button-primary" href="search">
                Explore products
            </a>

            <a class="ds-button ds-button-secondary" href="scan">
                Scan a product
            </a>
        </div>
    </section>
</div>