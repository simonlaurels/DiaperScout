@page "/join"
@page "/join/details"
@page "/join/check-email"
@layout OnboardingLayout
@inject NavigationManager Navigation
<PageTitle>Create your Explorer ID · DiaperScout</PageTitle>
<section class="explorer-card" data-onboarding-public>
    <a class="explorer-back" href="@(Details ? "/join" : "/")">‹ Back</a>
    @if (Waiting)
    {
        <span class="explorer-seal" aria-hidden="true">✉</span>
        <h1>Check your email</h1>
        <p>We sent a secure sign-in link to <strong data-onboarding-email>your email address</strong>.</p>
        <p>Open it to confirm this email belongs to you. The link brings you back here to finish your Explorer ID.</p>
        <p class="explorer-note">It expires in 15 minutes and works once. If you opened it in your browser, finish there; your account will also work in the installed app.</p>
        <AntiforgeryToken />
        <button class="ds-button ds-button-primary" type="button" data-onboarding-resend>Send again</button>
        <a class="explorer-secondary" href="/join/details">Use a different email</a>
        <a class="explorer-secondary" href="/join/continue" data-enhance-nav="false">I’ve verified my email</a>
        <p class="explorer-message" role="status" aria-live="polite" data-onboarding-message></p>
        <noscript>Open the email link to continue. Enable JavaScript to resend it here.</noscript>
    }
    else if (Details)
    {
        <p class="explorer-kicker">YOUR EXPLORER ID</p>
        <h1>Tell us about you</h1>
        <p>Just a name or nickname and your email. No password needed.</p>
        <form class="explorer-form" method="post" action="/join/request" data-onboarding-form data-enhance="false">
            <AntiforgeryToken />
            <label for="displayName">Name or nickname <span aria-hidden="true">*</span></label>
            <input id="displayName" name="displayName" type="text" autocomplete="nickname" required maxlength="100" aria-describedby="name-help" />
            <small id="name-help">This is how DiaperScout will know you. You can change it later.</small>
            <label for="email">Email address <span aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" maxlength="320" required aria-describedby="email-help" />
            <small id="email-help">We’ll send you a link to verify it. We won’t send spam.</small>
            <p class="explorer-message" role="status" aria-live="polite" data-onboarding-message>@(Error ? "We couldn’t verify or send that link. It may have expired or already been used. Request a fresh link to continue." : "")</p>
            <button class="ds-button ds-button-primary" type="submit">Continue</button>
        </form>
    }
    else
    {
        <img class="explorer-brand" src="/images/brand/DiaperScout.svg" alt="DiaperScout" />
        <img class="explorer-guide" src="/pwa/guide-map.webp" alt="The Guide explores a map, with Fox tucked in her backpack." />
        <h1>Create your Explorer ID</h1>
        <p>Keep your discoveries, submissions and everything you pick up along the way.</p>
        <ul class="explorer-benefits"><li>Save your discoveries</li><li>Submit new products and places</li><li>Keep your sign-in secure</li></ul>
        <a class="ds-button ds-button-primary" href="/join/details">Get started</a>
        <p class="explorer-footnote">Already exploring with us? <a href="/signin" data-enhance-nav="false">Sign in</a></p>
    }
</section>
@code {
    private string Path => new Uri(Navigation.Uri).AbsolutePath;
    private bool Details => Path == "/join/details";
    private bool Waiting => Path == "/join/check-email";
    [SupplyParameterFromQuery(Name = "error")] public bool Error { get; set; }
}
