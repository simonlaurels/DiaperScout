@page "/join"
@inject DiaperScout.Web.Services.UserManagementClient UserManagementClient

<PageTitle>Join DiaperScout</PageTitle>

<section class="ds-auth-page">
    <div class="ds-auth-card">
        <p class="catalogue-kicker">DIAPERSCOUT</p>
        <h1>Join DiaperScout</h1>

        @if (_loading)
        {
            <p>
                Checking registration availability...
            </p>
        }
        else if (!_registrationEnabled)
        {
            <div class="ds-auth-message">
                <strong>Registrations are currently closed</strong>
                <p>
                    We're not accepting new Explorer registrations right now.
                    Please check back later.
                </p>
            </div>
        }
        else if (Sent)
        {
            <div class="ds-auth-message ds-auth-message-success">
                <strong>Check your email</strong>
                <p>
                    If registration is currently available, we've sent a link to complete your DiaperScout account.
                    It expires in 15 minutes and can only be used once.
                </p>
            </div>
        }
        else
        {
            <p>
                Create your DiaperScout account to contribute to the catalogue and access tools available to your role.
            </p>

            <form class="ds-auth-form" method="post" action="/join/request">
                <label for="email">Email address</label>
                <input id="email"
                       name="email"
                       type="email"
                       autocomplete="email"
                       required
                       placeholder="you@example.com" />

                <label for="displayName">Explorer Display Name</label>
                <input id="displayName"
                       name="displayName"
                       type="text"
                       autocomplete="nickname"
                       maxlength="100"
                       required
                       placeholder="How you'd like to appear on DiaperScout" />

                <button class="ds-button ds-button-primary" type="submit">
                    Email me a registration link
                </button>
            </form>

            @if (Error)
            {
                <p class="ds-auth-error">
                    We couldn't start your registration. Please check the details provided and try again.
                </p>
            }
        }

        <p>
            Already have a DiaperScout account?
            <a href="/signin">Sign in</a>
        </p>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "sent")]
    private bool Sent { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private bool Error { get; set; }

    private bool _registrationEnabled;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var settings = await UserManagementClient.GetRegistrationSettingsAsync();

        _registrationEnabled = settings?.RegistrationEnabled ?? false;
        _loading = false;
    }
}