@page "/products/{Slug}"
@rendermode InteractiveServer
<ProductCatalogueScreen Slug="@Slug" VariantId="@VariantId" PackTypeId="@PackTypeId" />
@code {
    [Parameter] public string Slug {get;set;} = "";
    [SupplyParameterFromQuery(Name="variantId")] public string? VariantId {get;set;}
    [SupplyParameterFromQuery(Name="packTypeId")] public string? PackTypeId {get;set;}
}
