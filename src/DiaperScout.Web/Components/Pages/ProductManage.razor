@page "/catalogue/products/manage/{ProductId:guid}"
@rendermode InteractiveServer
@using DiaperScout.Application
@using DiaperScout.Domain
@using DiaperScout.Web.Services
@inject ProductCatalogueClient Catalogue

<PageTitle>Manage Product · DiaperScout</PageTitle>

<section class="product-editor-page">
    <div class="product-editor-container">
        <header class="product-editor-header">
            <a class="product-editor-back" href="/catalogue/products">← Back to Products</a>
            @if (product is not null)
            {
                <p class="catalogue-kicker">PRODUCT MANAGEMENT</p>
                <h1>Manage @product.Name</h1>
                <p class="product-editor-intro">Edit the canonical product record. Changes are saved directly to the catalogue.</p>
            }
            else
            {
                <p class="catalogue-kicker">PRODUCT MANAGEMENT</p>
                <h1>Manage Product</h1>
            }
        </header>

        @if (loading)
        {
            <section class="product-management-panel">
                <div class="product-management-empty">
                    <strong>Loading product…</strong>
                    <span>Fetching the canonical product record.</span>
                </div>
            </section>
        }
        else if (accessDenied)
        {
            <div class="product-management-message product-management-message-error" role="alert">
                <strong>Product management unavailable</strong>
                <p>You need Moderator or Administrator editorial authority to manage canonical products.</p>
            </div>
        }
        else if (notFound)
        {
            <div class="product-management-message product-management-message-error" role="alert">
                <strong>Product not found</strong>
                <p>The canonical product could not be found.</p>
                <a class="ds-button ds-button-secondary" href="/catalogue/products">Back to Products</a>
            </div>
        }
        else if (loadError is not null || product is null)
        {
            <div class="product-management-message product-management-message-error" role="alert">
                <strong>Couldn't load product</strong>
                <p>@(loadError ?? "The canonical product could not be loaded just now.")</p>
                <button class="ds-button ds-button-secondary" type="button" @onclick="LoadAsync">Try again</button>
            </div>
        }
        else
        {
            @if (saveMessage is not null)
            {
                <div class="product-management-message product-management-message-success" role="status">
                    @saveMessage
                </div>
            }
            @if (saveError is not null)
            {
                <div class="product-management-message product-management-message-error" role="alert">
                    <strong>Couldn't save product</strong>
                    <p>@saveError</p>
                </div>
            }

            <EditForm Model="editModel" OnValidSubmit="SaveAsync" FormName="canonical-product-edit">
                <div class="product-editor-panel">
                    <div class="product-editor-panel-heading">
                        <div>
                            <p class="catalogue-kicker">IDENTITY</p>
                            <h2>Product Identity</h2>
                        </div>
                        <span class="product-editor-status">@FormatEnum(product.Status)</span>
                    </div>
                    <p class="product-editor-help">Maintain the canonical identity of this product. Product name changes do not automatically change its public URL.</p>

                    <div class="product-editor-grid">
                        <div class="submission-field submission-field-wide">
                            <label for="product-name">Product name <span>*</span></label>
                            <InputText id="product-name" class="ds-input" @bind-Value="editModel.ProductName" />
                        </div>

                        <div class="submission-field">
                            <label for="manufacturer">Manufacturer <span>*</span></label>
                            <InputSelect id="manufacturer" class="ds-select" @bind-Value="editModel.ManufacturerId" @bind-Value:after="ManufacturerChangedAsync">
                                <option value="@Guid.Empty">Select manufacturer…</option>
                                @foreach (var manufacturer in entryOptions.Manufacturers)
                                {
                                    <option value="@manufacturer.Id">@manufacturer.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="submission-field">
                            <label for="brand">Brand</label>
                            <InputSelect id="brand" class="ds-select" @bind-Value="editModel.BrandId">
                                <option value="@Guid.Empty">No brand</option>
                                @foreach (var brand in AvailableBrands)
                                {
                                    <option value="@brand.Id">@brand.Name</option>
                                }
                            </InputSelect>
                            <small>Only brands belonging to the selected manufacturer are shown.</small>
                        </div>

                        <div class="submission-field">
                            <label for="family">Product family</label>
                            <InputText id="family" class="ds-input" @bind-Value="editModel.ProductFamily" />
                        </div>

                        <div class="submission-field">
                            <label for="product-type">Product type <span>*</span></label>
                            <InputSelect id="product-type" class="ds-select" @bind-Value="editModel.ProductType">
                                @foreach (var value in Enum.GetValues<ProductType>())
                                {
                                    <option value="@value">@FormatProductType(value)</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="submission-field submission-field-wide">
                            <label for="official-website">Official website</label>
                            <InputText id="official-website" class="ds-input" @bind-Value="editModel.OfficialWebsiteUrl" placeholder="https://…" />
                        </div>
                    </div>
                </div>

                <div class="product-editor-panel">
                    <div class="product-editor-panel-heading">
                        <div>
                            <p class="catalogue-kicker">CONTENT</p>
                            <h2>Description &amp; publication rights</h2>
                        </div>
                        <span class="product-editor-summary">@FormatEnum(editModel.DescriptionVisibility)</span>
                    </div>
                    <p class="product-editor-help">Maintain the canonical product description and decide whether it is eligible for public display.</p>
                    <div class="product-editor-grid">
                        <div class="submission-field submission-field-wide">
                            <label for="description">Description</label>
                            <InputTextArea id="description" class="ds-input ds-textarea" @bind-Value="editModel.Description" rows="6" />
                        </div>
                        <div class="submission-field">
                            <label for="description-visibility">Description visibility</label>
                            <InputSelect id="description-visibility" class="ds-select" @bind-Value="editModel.DescriptionVisibility">
                                @foreach (var value in Enum.GetValues<CatalogueContentVisibility>())
                                {
                                    <option value="@value">@FormatEnum(value)</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>

                <div class="product-editor-panel">
                    <div class="product-editor-panel-heading">
                        <div>
                            <p class="catalogue-kicker">CANONICAL STRUCTURE</p>
                            <h2>Variants &amp; Sizes</h2>
                        </div>
                        <span class="product-editor-summary">@product.Variants.Count variants · @product.Variants.Sum(value => value.Sizes.Count) sizes</span>
                    </div>
                    <p class="product-editor-help">Manage manufacturer-defined variants and their sizes directly on the canonical product.</p>

                    <div class="product-editor-inline-create">
                        <div>
                            <strong>Add variant</strong>
                            <span>Create another canonical manufacturer-defined variant.</span>
                        </div>
                        <div class="product-editor-inline-fields">
                            <input class="ds-input" placeholder="Variant name" @bind="newVariantName" />
                            <select class="ds-select" @bind="newVariantBacking">
                                @foreach (var value in Enum.GetValues<BackingType>())
                                {
                                    <option value="@value">@FormatEnum(value)</option>
                                }
                            </select>
                            <button class="ds-button ds-button-primary" type="button" @onclick="AddVariantAsync" disabled="@variantSaving">@(variantSaving ? "Adding…" : "Add variant")</button>
                        </div>
                    </div>

                    <div class="product-editor-variants">
                        @foreach (var variant in product.Variants)
                        {
                            <article class="product-editor-variant-card">
                                <div class="product-editor-variant-header">
                                    <div>
                                        <p class="catalogue-kicker">VARIANT</p>
                                        @if (editingVariantId == variant.Id)
                                        {
                                            <div class="product-editor-detail-grid">
                                                <div class="submission-field"><label>Variant name</label><input class="ds-input" @bind="editingVariantName" /></div>
                                                <div class="submission-field"><label>Backing type</label><select class="ds-select" @bind="editingVariantBacking">@foreach (var value in Enum.GetValues<BackingType>()) { <option value="@value">@FormatEnum(value)</option> }</select></div>
                                                <div class="submission-field"><label>Fastener type</label><select class="ds-select" @bind="editingVariantFastenerType">@foreach (var value in Enum.GetValues<FastenerType>()) { <option value="@value">@FormatEnum(value)</option> }</select></div>
                                                <div class="submission-field"><label>Fastener count</label><input class="ds-input" type="number" min="0" @bind="editingVariantFastenerCount" /></div>
                                                <div class="submission-field"><label>Appearance</label><select class="ds-select" @bind="editingVariantAppearance">@foreach (var value in Enum.GetValues<CatalogueVariantAppearance>()) { <option value="@value">@FormatEnum(value)</option> }</select></div>
                                                <div class="submission-field"><label>Primary colour</label><select class="ds-select" @bind="editingVariantPrimaryColour">@foreach (var value in Enum.GetValues<CatalogueVariantColour>()) { <option value="@value">@FormatEnum(value)</option> }</select></div>
                                                <div class="submission-field"><label>Wetness indicator</label><select class="ds-select" @bind="editingVariantWetness"><option value="">Unknown</option><option value="true">Yes</option><option value="false">No</option></select></div>
                                                <div class="submission-field"><label>Standing leak guards</label><select class="ds-select" @bind="editingVariantLeakGuards"><option value="">Unknown</option><option value="true">Yes</option><option value="false">No</option></select></div>
                                                <div class="submission-field"><label>Waistband style</label><select class="ds-select" @bind="editingVariantWaistbandStyle">@foreach (var value in Enum.GetValues<WaistbandStyle>()) { <option value="@value">@FormatEnum(value)</option> }</select></div>
                                                <div class="submission-field"><label>Fragrance</label><select class="ds-select" @bind="editingVariantFragrance">@foreach (var value in Enum.GetValues<FragranceType>()) { <option value="@value">@FormatEnum(value)</option> }</select></div>
                                                <div class="submission-field"><label>Latex free</label><select class="ds-select" @bind="editingVariantLatexFree"><option value="">Unknown</option><option value="true">Yes</option><option value="false">No</option></select></div>
                                                <div class="submission-field"><label>Designed for</label><select class="ds-select" @bind="editingVariantDesignedFor">@foreach (var value in Enum.GetValues<CatalogueVariantDesignedFor>()) { <option value="@value">@FormatEnum(value)</option> }</select></div>
                                                <div class="submission-field submission-field-wide"><label>Construction notes</label><textarea class="ds-input ds-textarea" rows="3" @bind="editingVariantConstructionNotes"></textarea></div>
                                            </div>
                                            <div class="product-editor-actions product-editor-inline-actions">
                                                <button class="ds-button ds-button-secondary" type="button" @onclick="CancelVariantEdit">Cancel</button>
                                                <button class="ds-button ds-button-primary" type="button" @onclick="() => SaveVariantAsync(variant.Id)" disabled="@variantSaving">@(variantSaving ? "Saving…" : "Save variant")</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <h3>@variant.Name</h3>
                                            <span>@FormatEnum(variant.BackingType) · @variant.Sizes.Count @(variant.Sizes.Count == 1 ? "size" : "sizes")</span>
                                        }
                                    </div>
                                    @if (editingVariantId != variant.Id)
                                    {
                                        <div class="product-editor-variant-actions">
                                            <button class="ds-button ds-button-secondary" type="button" @onclick="() => BeginVariantEdit(variant)">Edit</button>
                                            <button class="product-editor-remove-button" type="button" title="Remove variant" @onclick="() => RemoveVariantAsync(variant.Id)" disabled="@(variantSaving || product.Variants.Count <= 1)">@(confirmRemoveVariantId == variant.Id ? "Confirm remove" : "×")</button>
                                        </div>
                                    }
                                </div>

                                <div class="product-editor-sizes">
                                    <div class="product-editor-subheading">
                                        <div>
                                            <strong>Sizes</strong>
                                            <span>Manufacturer size and fit measurements</span>
                                        </div>
                                        <button class="ds-button ds-button-secondary" type="button" @onclick="() => BeginAddSize(variant.Id)">+ Add size</button>
                                    </div>

                                    @if (addingSizeVariantId == variant.Id)
                                    {
                                        <div class="product-editor-size-editor">
                                            <div class="product-editor-size-grid">
                                                <div class="submission-field">
                                                    <label>Manufacturer size <span>*</span></label>
                                                    <input class="ds-input" @bind="newSize.ManufacturerSize" />
                                                </div>
                                                <div class="submission-field">
                                                    <label>Pack quantity <span>*</span></label>
                                                    <input class="ds-input" type="number" min="1" @bind="newSize.ManufacturerPackQuantity" />
                                                </div>
                                                <div class="submission-field">
                                                    <label>Packaging <span>*</span></label>
                                                    <select class="ds-select" @bind="newSize.PackagingType">
                                                        @foreach (var value in Enum.GetValues<PackagingType>())
                                                        {
                                                            <option value="@value">@FormatEnum(value)</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="submission-field">
                                                    <label>GTIN</label>
                                                    <input class="ds-input" @bind="newSize.Gtin" />
                                                </div>
                                                <div class="submission-field">
                                                    <label>Waist minimum (cm)</label>
                                                    <input class="ds-input" type="number" min="0" @bind="newSize.WaistMinimumCm" />
                                                </div>
                                                <div class="submission-field">
                                                    <label>Waist maximum (cm)</label>
                                                    <input class="ds-input" type="number" min="0" @bind="newSize.WaistMaximumCm" />
                                                </div>
                                                <div class="submission-field">
                                                    <label>Hip minimum (cm)</label>
                                                    <input class="ds-input" type="number" min="0" @bind="newSize.HipMinimumCm" />
                                                </div>
                                                <div class="submission-field">
                                                    <label>Hip maximum (cm)</label>
                                                    <input class="ds-input" type="number" min="0" @bind="newSize.HipMaximumCm" />
                                                </div>
                                            </div>
                                            <div class="product-editor-actions product-editor-inline-actions">
                                                <button class="ds-button ds-button-secondary" type="button" @onclick="CancelAddSize">Cancel</button>
                                                <button class="ds-button ds-button-primary" type="button" @onclick="() => AddSizeAsync(variant.Id)" disabled="@sizeSaving">@(sizeSaving ? "Adding…" : "Add size")</button>
                                            </div>
                                        </div>
                                    }

                                    @foreach (var size in variant.Sizes)
                                    {
                                        <div class="product-editor-size-row">
                                            @if (editingSizeId == size.Id)
                                            {
                                                <div class="product-editor-size-editor product-editor-size-editor-compact">
                                                    <div class="product-editor-detail-grid">
                                                        <div class="submission-field"><label>Manufacturer size <span>*</span></label><input class="ds-input" @bind="editingSize.ManufacturerSize" /></div>
                                                        <div class="submission-field"><label>Fit measurement basis</label><input class="ds-input" @bind="editingSize.FitMeasurementBasis" placeholder="Waist, Hip, Waist and Hip…" /></div>
                                                        <div class="submission-field"><label>Waist minimum (cm)</label><input class="ds-input" type="number" min="0" @bind="editingSize.WaistMinimumCm" /></div>
                                                        <div class="submission-field"><label>Waist maximum (cm)</label><input class="ds-input" type="number" min="0" @bind="editingSize.WaistMaximumCm" /></div>
                                                        <div class="submission-field"><label>Hip minimum (cm)</label><input class="ds-input" type="number" min="0" @bind="editingSize.HipMinimumCm" /></div>
                                                        <div class="submission-field"><label>Hip maximum (cm)</label><input class="ds-input" type="number" min="0" @bind="editingSize.HipMaximumCm" /></div>
                                                        <div class="submission-field"><label>Manufacturer-stated absorbency (ml)</label><input class="ds-input" type="number" min="0" @bind="editingSize.ManufacturerStatedAbsorbencyMl" /></div>
                                                        <div class="submission-field"><label>Absorbency basis / method</label><input class="ds-input" @bind="editingSize.AbsorbencyBasisMethod" /></div>
                                                        <div class="submission-field submission-field-wide"><label>Absorbency source / provenance</label><input class="ds-input" @bind="editingSize.AbsorbencySource" /></div>
                                                        <div class="submission-field"><label>Product length (mm)</label><input class="ds-input" type="number" min="0" @bind="editingSize.LengthMm" /></div>
                                                        <div class="submission-field"><label>Product width (mm)</label><input class="ds-input" type="number" min="0" @bind="editingSize.WidthMm" /></div>
                                                        <div class="submission-field"><label>Product weight (g)</label><input class="ds-input" type="number" min="0" @bind="editingSize.WeightGrams" /></div>
                                                        <div class="submission-field"><label>Manufacturer pack quantity</label><input class="ds-input" type="number" min="1" @bind="editingSize.ManufacturerPackQuantity" /></div>
                                                        <div class="submission-field"><label>Packaging</label><select class="ds-select" @bind="editingSize.PackagingType">@foreach (var value in Enum.GetValues<PackagingType>()) { <option value="@value">@FormatEnum(value)</option> }</select></div>
                                                        <div class="submission-field submission-field-wide"><label>GTIN / barcode</label><input class="ds-input" @bind="editingSize.Gtin" placeholder="8–14 digits" /></div>
                                                    </div>
                                                    <div class="product-editor-actions product-editor-inline-actions">
                                                        <button class="ds-button ds-button-secondary" type="button" @onclick="CancelSizeEdit">Cancel</button>
                                                        <button class="ds-button ds-button-primary" type="button" @onclick="() => SaveSizeAsync(variant.Id, size.Id)" disabled="@sizeSaving">@(sizeSaving ? "Saving…" : "Save size")</button>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="product-editor-size-summary">
                                                    <strong>@size.ManufacturerSize</strong>
                                                    <span>@FormatRange(size.WaistMinimumCm, size.WaistMaximumCm, "waist") · @size.Packs.Count @(size.Packs.Count == 1 ? "pack" : "packs")</span>
                                                </div>
                                                <div class="product-editor-size-actions">
                                                    <button class="ds-button ds-button-secondary" type="button" @onclick="() => BeginSizeEdit(size)">Edit</button>
                                                    <button class="product-editor-remove-button" type="button" title="Remove size" @onclick="() => RemoveSizeAsync(variant.Id, size.Id)" disabled="@(sizeSaving || variant.Sizes.Count <= 1)">@(confirmRemoveSizeId == size.Id ? "Confirm remove" : "×")</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </div>

                <div class="product-editor-panel product-editor-images">
                    <div class="product-editor-panel-heading">
                        <div>
                            <p class="catalogue-kicker">MEDIA &amp; RIGHTS</p>
                            <h2>Images</h2>
                        </div>
                        <span class="product-editor-summary">@product.Images.Count @(product.Images.Count == 1 ? "image" : "images")</span>
                    </div>
                    <p class="product-editor-help">Manage catalogue images, their source and rights evidence. Images remain moderator-only unless the source and permission state make them eligible for public display.</p>

                    @if (product.Images.Count == 0)
                    {
                        <div class="product-editor-image-empty">No catalogue images are currently attached.</div>
                    }
                    else
                    {
                        <div class="product-editor-image-list">
                            @foreach (var image in product.Images)
                            {
                                <article class="product-editor-image-card">
                                    <div class="product-editor-image-preview">
                                        <img src="@image.ContentUrl" alt="@FormatEnum(image.Role)" />
                                    </div>
                                    <div class="product-editor-image-content">
                                        @if (editingImageId == image.Id)
                                        {
                                            <div class="product-editor-detail-grid">
                                                <div class="submission-field">
                                                    <label>Image role</label>
                                                    <select class="ds-select" @bind="editingImageRole">
                                                        @foreach (var value in Enum.GetValues<CatalogueSubmissionImageRole>())
                                                        {
                                                            <option value="@value">@FormatEnum(value)</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="submission-field">
                                                    <label>Source type</label>
                                                    <select class="ds-select" @bind="editingImageSourceType">
                                                        @foreach (var value in Enum.GetValues<CatalogueImageSourceType>())
                                                        {
                                                            <option value="@value">@FormatEnum(value)</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="submission-field submission-field-wide">
                                                    <label>Source URL</label>
                                                    <input class="ds-input" @bind="editingImageSourceUrl" placeholder="https://…" />
                                                </div>
                                                <div class="submission-field submission-field-wide">
                                                    <label>Source notes</label>
                                                    <textarea class="ds-input ds-textarea" @bind="editingImageSourceNotes" rows="3"></textarea>
                                                </div>
                                                <div class="submission-field">
                                                    <label>Permission status</label>
                                                    <select class="ds-select" @bind="editingImagePermissionStatus">
                                                        @foreach (var value in Enum.GetValues<CatalogueImagePermissionStatus>())
                                                        {
                                                            <option value="@value">@FormatEnum(value)</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="submission-field submission-field-wide">
                                                    <label>Permission evidence / terms</label>
                                                    <textarea class="ds-input ds-textarea" @bind="editingImagePermissionEvidence" rows="3"></textarea>
                                                </div>
                                            </div>
                                            <div class="product-editor-actions product-editor-inline-actions">
                                                <button class="ds-button ds-button-secondary" type="button" @onclick="CancelImageEdit">Cancel</button>
                                                <button class="ds-button ds-button-primary" type="button" @onclick="() => SaveImageAsync(image.Id)" disabled="@imageSaving">@(imageSaving ? "Saving…" : "Save image")</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="product-editor-image-heading">
                                                <div>
                                                    <strong>@FormatEnum(image.Role)</strong>
                                                    @if (image.IsPrimary)
                                                    {
                                                        <span class="product-editor-image-badge">Primary</span>
                                                    }
                                                </div>
                                                <span class="product-editor-status">@FormatEnum(image.Visibility)</span>
                                            </div>
                                            <div class="product-editor-image-meta">
                                                <span>Source: @FormatEnum(image.SourceType)</span>
                                                <span>Rights: @FormatEnum(image.PermissionStatus)</span>
                                                <span>@FormatFileSize(image.FileSizeBytes)</span>
                                            </div>
                                            @if (image.Visibility == CatalogueContentVisibility.ModeratorOnly)
                                            {
                                                <div class="product-editor-image-warning">Not eligible for public display until the source and permission state establish public visibility.</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(image.SourceUrl))
                                            {
                                                <a href="@image.SourceUrl" target="_blank" rel="noopener noreferrer">Open source ↗</a>
                                            }
                                            <div class="product-editor-actions product-editor-inline-actions">
                                                <button class="ds-button ds-button-secondary" type="button" @onclick="() => BeginImageEdit(image)">Edit</button>
                                                @if (!image.IsPrimary)
                                                {
                                                    <button class="ds-button ds-button-secondary" type="button" @onclick="() => SetPrimaryImageAsync(image.Id)" disabled="@imageSaving">Make primary</button>
                                                }
                                                <button class="product-editor-remove-button" type="button" @onclick="() => RemoveImageAsync(image.Id)" disabled="@imageSaving">@(confirmRemoveImageId == image.Id ? "Confirm remove" : "×")</button>
                                            </div>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }

                    <div class="product-editor-image-add">
                        <div class="product-editor-panel-heading">
                            <div>
                                <h3>Add image</h3>
                                <p class="product-editor-help">JPEG, PNG or WebP · maximum 15 MB.</p>
                            </div>
                        </div>
                        <div class="product-editor-detail-grid">
                            <div class="submission-field submission-field-wide">
                                <label>Image file <span>*</span></label>
                                <InputFile OnChange="ImageFileSelected" accept="image/jpeg,image/png,image/webp" />
                                @if (newImageFile is not null)
                                {
                                    <small>@newImageFile.Name · @FormatFileSize(newImageFile.Size)</small>
                                }
                            </div>
                            <div class="submission-field">
                                <label>Image role</label>
                                <select class="ds-select" @bind="newImageRole">
                                    @foreach (var value in Enum.GetValues<CatalogueSubmissionImageRole>())
                                    {
                                        <option value="@value">@FormatEnum(value)</option>
                                    }
                                </select>
                            </div>
                            <div class="submission-field">
                                <label>Source type</label>
                                <select class="ds-select" @bind="newImageSourceType">
                                    @foreach (var value in Enum.GetValues<CatalogueImageSourceType>())
                                    {
                                        <option value="@value">@FormatEnum(value)</option>
                                    }
                                </select>
                            </div>
                            <div class="submission-field submission-field-wide">
                                <label>Source URL</label>
                                <input class="ds-input" @bind="newImageSourceUrl" placeholder="https://…" />
                            </div>
                            <div class="submission-field submission-field-wide">
                                <label>Source notes</label>
                                <textarea class="ds-input ds-textarea" @bind="newImageSourceNotes" rows="3"></textarea>
                            </div>
                            <div class="submission-field">
                                <label>Permission status</label>
                                <select class="ds-select" @bind="newImagePermissionStatus">
                                    @foreach (var value in Enum.GetValues<CatalogueImagePermissionStatus>())
                                    {
                                        <option value="@value">@FormatEnum(value)</option>
                                    }
                                </select>
                            </div>
                            <div class="submission-field submission-field-wide">
                                <label>Permission evidence / terms</label>
                                <textarea class="ds-input ds-textarea" @bind="newImagePermissionEvidence" rows="3"></textarea>
                            </div>
                            <label class="product-editor-checkbox">
                                <input type="checkbox" @bind="newImageIsPrimary" />
                                <span>Make this the primary product image</span>
                            </label>
                        </div>
                        <div class="product-editor-actions product-editor-inline-actions">
                            <button class="ds-button ds-button-primary" type="button" @onclick="AddImageAsync" disabled="@(imageSaving || newImageFile is null)">@(imageSaving ? "Adding…" : "Add image")</button>
                        </div>
                    </div>
                </div>

                <div class="product-editor-panel product-editor-provenance">
                    <div class="product-editor-panel-heading">
                        <div>
                            <p class="catalogue-kicker">CHANGE RECORD</p>
                            <h2>Provenance &amp; rationale</h2>
                        </div>
                    </div>
                    <p class="product-editor-help">Every canonical edit records where the change came from and why it was made.</p>
                    <div class="product-editor-grid">
                        <div class="submission-field submission-field-wide">
                            <label for="source-summary">Source summary <span>*</span></label>
                            <InputText id="source-summary" class="ds-input" @bind-Value="editModel.SourceSummary" />
                        </div>
                        <div class="submission-field submission-field-wide">
                            <label for="source-references">Source references</label>
                            <InputTextArea id="source-references" class="ds-input ds-textarea" @bind-Value="editModel.SourceReferencesText" rows="3" placeholder="One URL or source reference per line" />
                        </div>
                        <div class="submission-field submission-field-wide">
                            <label for="editorial-rationale">Editorial rationale <span>*</span></label>
                            <InputTextArea id="editorial-rationale" class="ds-input ds-textarea" @bind-Value="editModel.EditorialRationale" rows="3" />
                        </div>
                    </div>
                </div>

                <div class="product-editor-actions">
                    <a class="ds-button ds-button-secondary" href="/catalogue/products">Cancel</a>
                    <button class="ds-button ds-button-primary" type="submit" disabled="@saving">@(saving ? "Saving…" : "Save changes")</button>
                </div>
            </EditForm>
        }
    </div>
</section>

@code {
    [Parameter] public Guid ProductId { get; set; }

    private CatalogueProductManagementDetails? product;
    private CatalogueEntryOptions entryOptions = new([], []);
    private ProductIdentityEditModel editModel = new();
    private bool loading = true;
    private bool accessDenied;
    private bool notFound;
    private bool saving;
    private string? loadError;
    private string? saveError;
    private string? saveMessage;

    private IEnumerable<CatalogueBrandOption> AvailableBrands =>
        editModel.ManufacturerId == Guid.Empty
            ? []
            : entryOptions.Brands.Where(value => value.ManufacturerId == editModel.ManufacturerId);

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        accessDenied = false;
        notFound = false;
        loadError = null;
        saveError = null;
        saveMessage = null;

        var result = await Catalogue.GetProductManagementAsync(ProductId);
        if (result.Status == CatalogueProductManagementStatus.AccessDenied)
        {
            accessDenied = true;
            loading = false;
            return;
        }

        if (result.Status == CatalogueProductManagementStatus.NotFound)
        {
            notFound = true;
            loading = false;
            return;
        }

        if (result.Status != CatalogueProductManagementStatus.Found || result.Product is null)
        {
            loadError = "The canonical product could not be loaded just now.";
            loading = false;
            return;
        }

        product = result.Product;
        entryOptions = await Catalogue.GetCatalogueEntryOptionsAsync();
        editModel = ProductIdentityEditModel.From(product);
        loading = false;
    }

    private Task ManufacturerChangedAsync()
    {
        if (editModel.BrandId != Guid.Empty &&
            !entryOptions.Brands.Any(value => value.Id == editModel.BrandId && value.ManufacturerId == editModel.ManufacturerId))
        {
            editModel.BrandId = Guid.Empty;
        }

        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        saveError = null;
        saveMessage = null;
        saving = true;

        try
        {
            if (editModel.ManufacturerId == Guid.Empty)
            {
                saveError = "Select a manufacturer.";
                return;
            }

            var request = new UpdateCanonicalProductIdentity(
                editModel.ManufacturerId,
                editModel.BrandId == Guid.Empty ? null : editModel.BrandId,
                editModel.ProductName,
                editModel.ProductType,
                editModel.ProductFamily,
                editModel.Description,
                editModel.DescriptionVisibility,
                editModel.OfficialWebsiteUrl,
                editModel.SourceSummary,
                editModel.SourceReferencesText.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
                editModel.EditorialRationale,
                null);

            var result = await Catalogue.UpdateProductIdentityAsync(ProductId, request);
            switch (result.Status)
            {
                case CatalogueProductManagementUpdateStatus.Saved:
                    saveMessage = "Product identity saved.";
                    await ReloadAfterSaveAsync();
                    break;
                case CatalogueProductManagementUpdateStatus.AccessDenied:
                    saveError = "You need Moderator or Administrator editorial authority to save canonical products.";
                    break;
                case CatalogueProductManagementUpdateStatus.NotFound:
                    saveError = "The canonical product could not be found.";
                    break;
                case CatalogueProductManagementUpdateStatus.Invalid:
                    saveError = FormatValidationErrors(result.Errors);
                    break;
                default:
                    saveError = "The product could not be saved just now.";
                    break;
            }
        }
        finally
        {
            saving = false;
        }
    }

