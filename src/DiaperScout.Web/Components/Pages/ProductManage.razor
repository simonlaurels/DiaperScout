    private static string FormatFileSize(long bytes) =>
        bytes < 1024 ? $"{bytes} B" : bytes < 1024 * 1024 ? $"{bytes / 1024d:0.#} KB" : $"{bytes / (1024d * 1024d):0.#} MB";

    private IReadOnlyList<string> SourceReferences() =>
        editModel.SourceReferencesText.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private void HandleManagementMutationResult(CatalogueProductManagementUpdateResult result, string successMessage)
    {
        saveMessage = null;
        saveError = result.Status switch
        {
            CatalogueProductManagementUpdateStatus.AccessDenied => "You need Moderator or Administrator editorial authority to change canonical products.",
            CatalogueProductManagementUpdateStatus.NotFound => "The canonical product or requested record could not be found.",
            CatalogueProductManagementUpdateStatus.Invalid => FormatValidationErrors(result.Errors),
            CatalogueProductManagementUpdateStatus.Failed => "The catalogue change could not be saved just now.",
            _ => null
        };
        if (result.Status == CatalogueProductManagementUpdateStatus.Saved)
            saveMessage = successMessage;
    }

    private static string FormatRange(int? minimum, int? maximum, string label) =>
        minimum is null && maximum is null
            ? $"{label}: not recorded"
            : $"{label}: {(minimum?.ToString() ?? "?")}–{(maximum?.ToString() ?? "?")} cm";


    private sealed class CanonicalSizeEditModel
    {
        public string ManufacturerSize { get; set; } = string.Empty;
        public int? WaistMinimumCm { get; set; }
        public int? WaistMaximumCm { get; set; }
        public int? HipMinimumCm { get; set; }
        public int? HipMaximumCm { get; set; }
        public int? ManufacturerStatedAbsorbencyMl { get; set; }
        public string? FitMeasurementBasis { get; set; }
        public string? AbsorbencyBasisMethod { get; set; }
        public string? AbsorbencySource { get; set; }
        public int? LengthMm { get; set; }
        public int? WidthMm { get; set; }
        public int? WeightGrams { get; set; }
        public int ManufacturerPackQuantity { get; set; } = 1;
        public PackagingType PackagingType { get; set; } = PackagingType.Bag;
        public string? Gtin { get; set; }
    }

    private async Task ReloadAfterSaveAsync()
    {
        var result = await Catalogue.GetProductManagementAsync(ProductId);
        if (result.Status == CatalogueProductManagementStatus.Found && result.Product is not null)
        {
            product = result.Product;
            editModel = ProductIdentityEditModel.From(product, editModel.SourceSummary, editModel.SourceReferencesText, editModel.EditorialRationale);
        }
    }

    private static string FormatValidationErrors(IReadOnlyDictionary<string, string[]>? errors) =>
        errors is null || errors.Count == 0
            ? "The product details are not valid."
            : string.Join(" ", errors.SelectMany(value => value.Value));

    private static string FormatEnum<T>(T value) =>
        System.Text.RegularExpressions.Regex.Replace(value?.ToString() ?? string.Empty, "(?<!^)([A-Z])", " $1");

    private static string FormatProductType(ProductType value) =>
        value == ProductType.Tape ? "Diaper" : FormatEnum(value);

    private sealed class ProductIdentityEditModel
    {
        public Guid ManufacturerId { get; set; }
        public Guid BrandId { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public ProductType ProductType { get; set; }
        public string? ProductFamily { get; set; }
        public string? Description { get; set; }
        public CatalogueContentVisibility DescriptionVisibility { get; set; } = CatalogueContentVisibility.Public;
        public string? OfficialWebsiteUrl { get; set; }
        public string SourceSummary { get; set; } = string.Empty;
        public string SourceReferencesText { get; set; } = string.Empty;
        public string EditorialRationale { get; set; } = string.Empty;

        public static ProductIdentityEditModel From(
            CatalogueProductManagementDetails product,
            string? sourceSummary = null,
            string? sourceReferences = null,
            string? editorialRationale = null) => new()
            {
                ManufacturerId = product.ManufacturerId,
                BrandId = product.BrandId ?? Guid.Empty,
                ProductName = product.Name,
                ProductType = product.ProductType,
                ProductFamily = product.ProductFamily,
                Description = product.Description,
                DescriptionVisibility = product.DescriptionVisibility,
                OfficialWebsiteUrl = product.OfficialWebsiteUrl,
                SourceSummary = sourceSummary ?? "Canonical product management edit",
                SourceReferencesText = sourceReferences ?? string.Empty,
                EditorialRationale = editorialRationale ?? "Updated the canonical product identity from verified catalogue information."
            };
    }
