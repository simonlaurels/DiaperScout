@page "/catalogue/products"
@rendermode InteractiveServer
@using DiaperScout.Application
@using DiaperScout.Domain
@using DiaperScout.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject ProductCatalogueClient Catalogue
@inject NavigationManager Navigation

<PageTitle>Product Management · DiaperScout</PageTitle>

<section class="product-management-page">
    <div class="product-management-container">
        <header class="product-management-header">
            <div>
                <p class="catalogue-kicker">CATALOGUE WORKSPACE</p>
                <h1>Product Management</h1>
                <p class="product-management-intro">
                    Manage catalogue submissions and continue products that are still being prepared.
                    Published products will have their own management view later.
                </p>
            </div>

            <div class="product-management-header-actions">
                <a class="ds-button ds-button-secondary" href="@Catalogue.GetSubmissionImportTemplateUrl()">Download CSV template</a>
                <label class="ds-button ds-button-secondary import-file-button">
                    Import CSV
                    <InputFile OnChange="HandleCsvSelected" accept=".csv,text/csv" />
                </label>
                <a class="ds-button ds-button-primary" href="/catalogue/add">＋ Add Product</a>
            </div>
        </header>

        @if (loading)
        {
            <section class="product-management-panel">
                <div class="product-management-empty">
                    <strong>Loading submissions…</strong>
                    <span>Fetching the current catalogue queue.</span>
                </div>
            </section>
        }
        else if (accessDenied)
        {
            <div class="product-management-message product-management-message-error" role="alert">
                <strong>Product management unavailable</strong>
                <p>You need Moderator editorial authority to manage catalogue submissions.</p>
            </div>
        }
        else if (loadError is not null)
        {
            <div class="product-management-message product-management-message-error" role="alert">
                <strong>Couldn't load the submission queue</strong>
                <p>@loadError</p>
            </div>
        }
        else
        {
            @if (importFile is not null)
            {
                <section class="product-management-import-panel">
                    <div>
                        <p class="catalogue-kicker">BULK INGESTION</p>
                        <h2>Import catalogue candidates</h2>
                        <p>CSV rows become normal moderator submissions. Imported descriptions are moderator-only by default until their publication rights are established. Nothing is published automatically.</p>
                        @if (importResult is not null)
                        {
                            <p class="product-management-import-result">
                                Imported @importResult.RowsImported of @importResult.RowsRead rows · @importResult.SubmissionsCreated submissions created · @importResult.RowsSkipped skipped.
                            </p>
                            @if (importResult.Warnings.Count > 0)
                            {
                                <details>
                                    <summary>@importResult.Warnings.Count warning@(importResult.Warnings.Count == 1 ? "" : "s")</summary>
                                    <ul>
                                        @foreach (var warning in importResult.Warnings.Take(20))
                                        {
                                            <li>@warning</li>
                                        }
                                    </ul>
                                </details>
                            }
                        }
                        @if (importError is not null)
                        {
                            <div class="product-management-message product-management-message-error" role="alert">@importError</div>
                        }
                    </div>
                    <div class="submission-queue-action">
                        <span>@importFile.Name</span>
                        <button class="ds-button ds-button-primary" type="button" @onclick="ImportCsvAsync" disabled="@importing">@(importing ? "Importing…" : "Import CSV")</button>
                        <button class="ds-button ds-button-secondary" type="button" @onclick="ClearImport">Cancel</button>
                    </div>
                </section>
            }

            <section class="product-management-panel">
                <div class="product-management-panel-heading">
                    <div>
                        <p class="catalogue-kicker">PRODUCTS</p>
                        <h2>Submission Queue</h2>
                    </div>
                    <span class="product-management-count">
                        @submissions.Count @(submissions.Count == 1 ? "submission" : "submissions")
                    </span>
                </div>

                <p class="product-management-help">
                    Draft and in-progress catalogue work lives here. Status tells you where the
                    submission is in the editorial lifecycle; workflow progress shows the creation
                    step to resume.
                </p>

                @if (submissions.Count == 0)
                {
                    <div class="product-management-empty">
                        <strong>No catalogue submissions yet</strong>
                        <span>Start a product entry and it will appear here as soon as it is created.</span>
                        <a class="ds-button ds-button-secondary" href="/catalogue/add">＋ Add Product</a>
                    </div>
                }
                else
                {
                    <div class="submission-queue" role="list">
                        @foreach (var submission in submissions)
                        {
                            <article class="submission-queue-item" role="listitem">
                                <div class="submission-queue-main">
                                    <div class="submission-queue-product">
                                        <strong>@submission.ProposedProductName</strong>
                                        <span>
                                            @submission.ProposedManufacturerName
                                            @if (!string.IsNullOrWhiteSpace(submission.ProposedBrandName))
                                            {
                                                <text> · @submission.ProposedBrandName</text>
                                            }
                                        </span>
                                    </div>

                                    <div class="submission-queue-meta">
                                        <div>
                                            <span class="submission-queue-label">STATUS</span>
                                            <strong class="submission-status-badge status-@submission.Status.ToString().ToLowerInvariant()">
                                                @FormatEnum(submission.Status)
                                            </strong>
                                        </div>

                                        <div>
                                            <span class="submission-queue-label">WORKFLOW</span>
                                            <strong>@GetWorkflowProgress(submission.Status)</strong>
                                        </div>

                                        <div>
                                            <span class="submission-queue-label">LAST UPDATED</span>
                                            <strong>@FormatUpdated(submission.UpdatedAtUtc)</strong>
                                        </div>
                                    </div>
                                </div>

                                <div class="submission-queue-action">
                                    <a class="ds-button ds-button-secondary"
                                       href="@GetActionUrl(submission)">
                                        @GetActionLabel(submission.Status) →
                                    </a>

                                    @if (submission.Status == CatalogueSubmissionStatus.Published && submission.PublishedProductId is Guid publishedProductId)
                                    {
                                        <a class="ds-button ds-button-secondary" href="/catalogue/products/preview/@publishedProductId">Moderator preview</a>
                                    }

                                    @if (CanDelete(submission.Status))
                                    {
                                        @if (deletingSubmissionId == submission.Id)
                                        {
                                            <div class="submission-delete-confirmation">
                                                <span>Delete this draft?</span>
                                                <button class="ds-button ds-button-danger"
                                                        type="button"
                                                        @onclick="() => DeleteAsync(submission)"
                                                        disabled="@deleting">
                                                    Delete
                                                </button>
                                                <button class="ds-button ds-button-secondary"
                                                        type="button"
                                                        @onclick="CancelDelete"
                                                        disabled="@deleting">
                                                    Cancel
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <button class="ds-button ds-button-secondary"
                                                    type="button"
                                                    @onclick="() => BeginDelete(submission)">
                                                Delete
                                            </button>
                                        }
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        }
    </div>
</section>

@code {
    private IReadOnlyList<CatalogueSubmissionQueueItem> submissions = [];
    private bool loading = true;
    private bool accessDenied;
    private string? loadError;
    private Guid? deletingSubmissionId;
    private bool deleting;
    private IBrowserFile? importFile;
    private bool importing;
    private string? importError;
    private CatalogueSubmissionImportResult? importResult;

    private void HandleCsvSelected(InputFileChangeEventArgs args)
    {
        importFile = args.File;
        importError = null;
        importResult = null;
    }

    private void ClearImport()
    {
        importFile = null;
        importError = null;
        importResult = null;
    }

    private async Task ImportCsvAsync()
    {
        if (importFile is null) return;
        importing = true;
        importError = null;
        importResult = null;
        try
        {
            var result = await Catalogue.ImportSubmissionsCsvAsync(importFile);
            if (result.Status == CatalogueSubmissionImportClientStatus.AccessDenied)
                importError = "You need Moderator editorial authority to import catalogue submissions.";
            else if (result.Status == CatalogueSubmissionImportClientStatus.Failed)
                importError = result.Message ?? "The CSV import could not be completed.";
            else
            {
                importResult = result.Result;
                await LoadAsync();
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or IOException)
        {
            importError = "The CSV import could not be completed just now.";
        }
        finally
        {
            importing = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        accessDenied = false;
        loadError = null;

        try
        {
            var result = await Catalogue.GetSubmissionsAsync();

            switch (result.Status)
            {
                case CatalogueSubmissionQueueResultStatus.Found:
                    submissions = result.Submissions ?? [];
                    break;

                case CatalogueSubmissionQueueResultStatus.AccessDenied:
                    accessDenied = true;
                    break;

                default:
                    loadError = result.Message
                        ?? "The catalogue submission queue could not be loaded just now.";
                    break;
            }
        }
        catch (HttpRequestException)
        {
            loadError = "The catalogue submission queue could not be reached just now.";
        }
        finally
        {
            loading = false;
        }
    }

    private static bool CanDelete(CatalogueSubmissionStatus status) =>
        status is CatalogueSubmissionStatus.Draft or CatalogueSubmissionStatus.NeedsChanges;

    private void BeginDelete(CatalogueSubmissionQueueItem submission)
    {
        deletingSubmissionId = submission.Id;
    }

    private void CancelDelete()
    {
        deletingSubmissionId = null;
    }

    private async Task DeleteAsync(CatalogueSubmissionQueueItem submission)
    {
        deleting = true;
        loadError = null;

        try
        {
            var result = await Catalogue.DeleteSubmissionAsync(submission.Id);

            if (result.Status == CatalogueSubmissionResultStatus.AccessDenied)
            {
                accessDenied = true;
            }
            else if (result.Status == CatalogueSubmissionResultStatus.Deleted)
            {
                deletingSubmissionId = null;
                await LoadAsync();
            }
            else
            {
                loadError = result.Message
                    ?? "The submission could not be deleted just now.";
            }
        }
        catch (HttpRequestException)
        {
            loadError = "The submission could not be deleted just now.";
        }
        finally
        {
            deleting = false;
        }
    }

    private static string GetWorkflowProgress(CatalogueSubmissionStatus status) =>
        status switch
        {
            CatalogueSubmissionStatus.Draft =>
                "Step 2 of 6 · Product Variants",
            CatalogueSubmissionStatus.NeedsChanges =>
                "Resume · Changes requested",
            CatalogueSubmissionStatus.InVerification =>
                "Step 6 of 6 · Verification",
            CatalogueSubmissionStatus.ReadyForReview =>
                "Step 6 of 6 · Ready for review",
            CatalogueSubmissionStatus.Approved =>
                "Catalogue-ready · Approved",
            CatalogueSubmissionStatus.Rejected =>
                "Workflow closed · Rejected",
            CatalogueSubmissionStatus.Published =>
                "Published · Catalogue",
            _ =>
                "Workflow status available"
        };

    private static string GetActionLabel(CatalogueSubmissionStatus status) =>
        status switch
        {
            CatalogueSubmissionStatus.Draft =>
                "Continue",
            CatalogueSubmissionStatus.NeedsChanges =>
                "Review",
            CatalogueSubmissionStatus.InVerification =>
                "Review",
            CatalogueSubmissionStatus.ReadyForReview =>
                "Review",
            CatalogueSubmissionStatus.Approved =>
                "Review",
            CatalogueSubmissionStatus.Rejected =>
                "Review",
            CatalogueSubmissionStatus.Published =>
                "View",
            _ =>
                "Open"
        };

    private static string GetActionUrl(CatalogueSubmissionQueueItem submission) =>
        submission.Status switch
        {
            CatalogueSubmissionStatus.Draft =>
                $"/catalogue/add/{submission.Id}/2",
            CatalogueSubmissionStatus.NeedsChanges =>
                $"/catalogue/add/{submission.Id}/1",
            CatalogueSubmissionStatus.InVerification =>
                $"/catalogue/add/{submission.Id}/6",
            CatalogueSubmissionStatus.ReadyForReview =>
                $"/catalogue/add/{submission.Id}/6",
            _ =>
                $"/catalogue/add/{submission.Id}/6"
        };

    private static string FormatUpdated(DateTimeOffset value) =>
        value.ToLocalTime().ToString("d MMM yyyy, HH:mm");

    private static string FormatEnum<T>(T value) =>
        System.Text.RegularExpressions.Regex.Replace(
            value?.ToString() ?? string.Empty,
            "(?<!^)([A-Z])",
            " $1");
}
