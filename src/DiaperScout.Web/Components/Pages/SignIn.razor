@page "/signin"

<PageTitle>Sign in · DiaperScout</PageTitle>

<section class="ds-auth-page">
    <div class="ds-auth-card">
        <p class="catalogue-kicker">DIAPERSCOUT</p>
        <h1>Sign in</h1>
        <p>
            Sign in to access your DiaperScout account and any tools available to your role.
        </p>

        <div class="ds-passkey-signin" data-passkey-signin>
            <AntiforgeryToken />
            <button class="ds-button ds-button-primary" type="button" data-passkey-action="signin">Sign in with a passkey</button>
            <p data-passkey-message role="status" aria-live="polite"></p>
            <p>Already added a passkey? Use your fingerprint, face, device PIN, or security key.</p>
        </div>
        <p>Or sign in with an email link.</p>
        @if (ContributionReturn.Validate(ReturnUrl) is { } target)
        {
            <p>Your contribution is waiting. After sign-in, you’ll return to it.</p>
            <a href="@target">Back to your contribution</a>
        }

        @if (Sent)
        {
            <div class="ds-auth-message ds-auth-message-success">
                <strong>Check your email</strong>
                <p>
                    If that email address can receive DiaperScout sign-in links, we've sent you a link.
                    It expires in 15 minutes and can only be used once.
                </p>
            </div>
        }
        else
        {
            <form class="ds-auth-form" method="post" action="/signin/request">
                <AntiforgeryToken />
                <label for="email">Email address</label>
                <input id="email"
                       name="email"
                       type="email"
                       autocomplete="email"
                       required
                       placeholder="you@example.com" />
                <button class="ds-button ds-button-primary" type="submit">
                    Email me a sign-in link
                </button>
            </form>

            @if (Error)
            {
                <p class="ds-auth-error">
                    We couldn't sign you in with that link. It may have expired or already been used.
                    Please request a new one.
                </p>
            }
        }

        @if (Environment.IsDevelopment())
        {
            <div class="ds-auth-development">
                <strong>Development environment</strong>
                <p>
                    Use the development moderator identity to exercise catalogue management locally.
                </p>
                <a class="ds-button ds-button-primary" href="/signin/development" data-enhance-nav="false">
                    Sign in as development moderator
                </a>
            </div>
        }
    </div>
</section>

@code {
    [Inject]
    private IHostEnvironment Environment { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "sent")]
    private bool Sent { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private bool Error { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] private string? ReturnUrl { get; set; }
}
