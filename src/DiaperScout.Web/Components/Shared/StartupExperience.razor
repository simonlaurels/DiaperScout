<div id="pwa-startup" class="pwa-startup" data-permanent>
    <div class="pwa-startup-card" role="status" aria-live="polite" aria-atomic="true">
        <img class="pwa-startup-brand" src="/images/brand/DiaperScout.svg" alt="DiaperScout" width="230" />
        <img class="pwa-guide" src="/pwa/guide-map.webp" alt="" width="220" height="220" />
        <p class="pwa-eyebrow">Your next discovery starts here</p>
        <h2 id="pwa-startup-title">Preparing your map…</h2>
        <p id="pwa-startup-description">Getting things ready for your next discovery.</p>
        <div class="pwa-progress" aria-hidden="true"><span></span></div>
        <button id="pwa-startup-retry" class="ds-button ds-button-primary" type="button" hidden>Reload and try again</button>
    </div>
</div>
